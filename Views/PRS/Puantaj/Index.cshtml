@{
    ViewData["Title"] = "Puantaj Takvimi";
    Layout = "_Layout";
}

<div class="puantaj-wrapper">
    <!-- HEADER -->
    <div class="puantaj-header shadow-sm p-3 mb-5 bg-body-tertiary rounded">
        <div class="row align-items-center g-2 mb-2">
            <div class="col-md-6">
                <div class="page-headline"><i class="fas fa-calendar-alt me-2"></i>Puantaj Takvimi</div>
                <div class="page-sub">Personel çalışma ve izin durumlarını aylık olarak görüntüleyin.</div>
            </div>
            <div class="col-md-6">
                <div class="btn-group-icon no-print">
                    <button class="btn-puantaj btn-warning-puantaj" id="batchIzinBtn"><i class="fas fa-users me-1"></i>Toplu İzin</button>
                    <button class="btn-puantaj btn-success-puantaj" id="saveBtn"><i class="fas fa-save me-1"></i>Kaydet</button>
                    <button class="btn-puantaj btn-info-puantaj" id="exportBtn"><i class="fas fa-file-excel me-1"></i>Dışa Aktar</button>
                    <button class="btn-puantaj btn-outline-puantaj" id="previewBtn" type="button">Önizle</button>
                    <button class="btn-puantaj btn-outline-puantaj" id="pdfExportBtn" type="button">PDF Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <section class="card mb-3" aria-labelledby="aylikIzinKayitlariBaslik">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h6 mb-0" id="aylikIzinKayitlariBaslik">Seçili Ayın İzin Kayıtları</h2>
            <span class="badge bg-secondary" id="aylikIzinKayitSayisi">0 kayıt</span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Tarih</th>
                        <th scope="col">Personel No</th>
                        <th scope="col">Personel</th>
                        <th scope="col">İzin Türü</th>
                        <th scope="col">Açıklama</th>
                    </tr>
                </thead>
                <tbody id="aylikIzinKayitlariBody">
                    <tr><td colspan="5" class="text-center text-muted">Veriler yükleniyor...</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <!-- FILTER ROW -->
    <div class="controls row g-2 align-items-end mb-2">
            <div class="filter-field col-md-3">
                <label for="birimSelect">Birim</label>
            @if (ViewBag.Rol == "admin")
            {
                <select id="birimSelect" class="form-select">
                    <option value="all">Tüm Birimler</option>
                    @if (ViewBag.Birimler != null)
                    {
                        @foreach (string birim in ViewBag.Birimler)
                        {
                            <option value="@birim">@birim</option>
                        }
                    }
                </select>
            }
            else
            {
                <span class="filter-static">@(ViewBag.KullaniciBirim ?? "Biriminiz")</span>
            }
            </div>

            <div class="filter-field col-md-3">
                <label for="statuSelect">Personel Statüsü</label>
                <select id="statuSelect" class="form-select" aria-label="Personel Statüsü">
                    <option value="__TUMU__">Tüm Personeller</option>
                </select>
            </div>

            <div class="filter-field col-md-3">
                <label for="personelArama">Personel Ara</label>
                <input id="personelArama" type="search" class="form-control" placeholder="Ad veya soyad yazın..." autocomplete="off" />
            </div>

            <div class="filter-field col-md-3">
                <label>Ay ve Yıl</label>
                <div class="calendar-nav">
                    <button type="button" class="month-nav-button" id="previousMonthBtn" aria-label="Önceki ay" title="Önceki ay"><span aria-hidden="true">←</span></button>
                    <span class="month-badge" id="monthTitle">Mart 2026</span>
                    <button type="button" class="month-nav-button" id="nextMonthBtn" aria-label="Sonraki ay" title="Sonraki ay"><span aria-hidden="true">→</span></button>
                </div>
            </div>
            <div class="col-12 d-flex justify-content-between align-items-center gap-2 flex-wrap mt-1">
                <span class="birim-badge" id="birimBadge">Tüm Birimler</span>
            </div>
    </div>

    <!-- INFO ALERT -->
    <div class="alert-info-custom d-flex align-items-center gap-3 no-print mb-2">
        <i class="fas fa-info-circle"></i>
        <div><strong>Hücreye tıklayarak düzenleyin.</strong> Klavyeden X, İ, G, Ç, V, Ö veya H tuşlarını kullanabilirsiniz.</div>
    </div>

    <div class="legend-row mb-2">
        <button class="btn-legend-toggle" id="legendToggleBtn">🎨 Renk Açıklamaları ▼</button>
        <div class="legend" id="legendPanel" style="display:none;">
            <div class="legend-item"><span class="legend-color lx"></span>X</div>
            <div class="legend-item"><span class="legend-color li"></span>İ</div>
            <div class="legend-item"><span class="legend-color lgi"></span>Gİ</div>
            <div class="legend-item"><span class="legend-color lch"></span>ÇH</div>
            <div class="legend-item"><span class="legend-color lv"></span>Vİ</div>
            <div class="legend-item"><span class="legend-color loz"></span>Öİ</div>
            <div class="legend-item"><span class="legend-color lh"></span>H</div>
            <div class="legend-item"><span class="legend-color lsi"></span>Sİ</div>
            <div class="legend-item"><span class="legend-color lodi"></span>ÖDİ</div>
        </div>
    </div>

    <!-- TABLO -->
    <div class="table-wrapper">
        <table class="puantaj-table" id="puantajTable">
            <thead id="tableHeader"></thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>

    <!-- FOOTER -->
    <div class="footer">
        <span><i class="fas fa-info-circle me-1"></i>Hücreye tıklayarak düzenleyin | Klavye: X,İ,G,Ç,V,Ö,H</span>
        <span><i class="fas fa-users me-1"></i><span id="totalPersonel">0</span> personel</span>
        <span id="autoSaveStatus" class="auto-save-status active">💾 Değişiklikler otomatik kaydedilir</span>
    </div>
</div>

<!-- ========== MODAL ========== -->
<div id="editModal" class="modal-overlay">
    <div class="modal-content">
        <h3><i class="fas fa-edit me-2"></i>Durum Düzenle</h3>
        <p id="modalPersonelInfo" class="fw-semibold text-primary"></p>
        <p id="modalTarihInfo" class="text-muted small"></p>
        <div class="mb-3">
            <label class="form-label">Durum</label>
            <select id="modalDurum" class="form-select">
                <option value="X">✅ Çalıştı (X)</option>
                <option value="İ">🟡 Yıllık İzin (İ)</option>
                <option value="Gİ">🟠 Görev İzni (Gİ)</option>
                <option value="ÇH">🟢 Çocuk Hastalık (ÇH)</option>
                <option value="Vİ">🟣 Vefat İzni (Vİ)</option>
                <option value="Öİ">🔴 Özel İzin (Öİ)</option>
                <option value="H">🔴 Hastalık (H)</option>
                <option value="Sİ">🔵 Seferberlik İzni (Sİ)</option>
                <option value="ÖDİ">🔷 Ödeneksiz İzin (ÖDİ)</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Açıklama (opsiyonel)</label>
            <textarea id="modalAciklama" class="form-control" rows="3"></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeModal()">İptal</button>
            <button class="btn-save-modal" onclick="saveModal()">Kaydet</button>
        </div>
    </div>
</div>

<!-- ========== TOPLU İZİN MODAL ========== -->
<div id="batchModal" class="modal-overlay">
    <div class="modal-content">
        <h3><i class="fas fa-users me-2"></i>Toplu İzin Girişi</h3>
        <div class="mb-3">
            <label class="form-label">👥 Personel Seç (Ctrl ile çoklu)</label>
            <select id="batchPersonelSelect" class="form-select" multiple size="6"></select>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-6">
                <label class="form-label">Başlangıç</label>
                <input type="date" id="baslangicTarih" class="form-control">
            </div>
            <div class="col-6">
                <label class="form-label">Bitiş</label>
                <input type="date" id="bitisTarih" class="form-control">
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">İzin Türü</label>
            <select id="batchIzinTipi" class="form-select">
                <option value="İ">🟡 Yıllık İzin (İ)</option>
                <option value="Gİ">🟠 Görev İzni (Gİ)</option>
                <option value="ÇH">🟢 Çocuk Hastalık (ÇH)</option>
                <option value="Vİ">🟣 Vefat İzni (Vİ)</option>
                <option value="Öİ">🔴 Özel İzin (Öİ)</option>
                <option value="H">🔴 Hastalık (H)</option>
                <option value="Sİ">🔵 Seferberlik İzni (Sİ)</option>
                <option value="ÖDİ">🔷 Ödeneksiz İzin (ÖDİ)</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea id="batchAciklama" class="form-control" rows="2" placeholder="Toplu izin açıklaması"></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeBatchModal()">İptal</button>
            <button class="btn-save-modal" onclick="saveBatchIzin()">Toplu Ekle</button>
        </div>
    </div>
</div>

<!-- ========== KİLİT POPUP ========== -->
<div id="kilitPopupOverlay" class="modal-overlay">
    <div style="background:white; border-radius:12px; padding:30px 36px; max-width:400px; width:90%; text-align:center; box-shadow:0 8px 32px rgba(0,0,0,0.3);">
        <div style="font-size:48px; margin-bottom:10px;">🔒</div>
        <h5 style="color:#dc3545; font-weight:700; margin-bottom:10px;">Ay Kilitli</h5>
        <p id="kilitPopupMesaj" style="color:#555; margin-bottom:20px;"></p>
        <button onclick="kilitPopupKapat()" style="background:#dc3545; color:white; border:none; padding:8px 32px; border-radius:6px; font-size:14px; cursor:pointer;">Tamam</button>
    </div>
</div>

<!-- ========== TOAST ========== -->
<div id="toastContainer" class="toast-container"></div>

<!-- ========== SCRIPTS ========== -->
<script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>
<script>
    // ============================================================
    // KONFIGÜRASYON
    // ============================================================
    var izinTurleri = ['İ', 'Gİ', 'ÇH', 'Vİ', 'Öİ', 'H', 'Sİ', 'ÖDİ'];
    var personeller = [];
    var calismaVerileri = {};
    var degisenler = {};
    var currentYear = 2026;
    var currentMonth = 3;
    var seciliStatu = '__TUMU__';
    var personelAramaMetni = '';
    var kullaniciRol = '@(ViewBag.Rol ?? "birim_amiri")';
    var kullaniciBirim = '@(ViewBag.KullaniciBirim ?? "")';
    var seciliBirim = kullaniciRol === 'admin' ? 'all' : kullaniciBirim;
    var autoSaveTimer = null;
    var isSaving = false;
    var izinYuklemeNo = 0;
    var aylikIzinKayitlari = [];
    var izinPersonelBilgileri = {};

    // ============================================================
    // YARDIMCI FONKSİYONLAR
    // ============================================================
    function getMonthName(m) { return ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'][m-1]; }
    function isWeekend(y, m, d) { var dt = new Date(y, m-1, d); return dt.getDay()===0 || dt.getDay()===6; }
    function getDurumClass(d) { return {'X':'x','İ':'i','Gİ':'gi','ÇH':'ch','Vİ':'vi','Öİ':'oi','H':'h','Sİ':'si','ÖDİ':'odi'}[d]||'x'; }
    function getDurumDisplay(d) { return {'X':'X','İ':'İ','Gİ':'Gİ','ÇH':'ÇH','Vİ':'Vİ','Öİ':'Öİ','H':'H','Sİ':'Sİ','ÖDİ':'ÖDİ'}[d]||'X'; }
    function getPersonelBilgisi(pid) {
        return personeller.find(function(x){return String(x.personelId)===String(pid);}) ||
            izinPersonelBilgileri[pid] || null;
    }
    function getPersonelAdi(pid) {
        var p = getPersonelBilgisi(pid);
        return p ? (p.ad+' '+p.soyad).trim() : '';
    }
    function renderIzinKayitlari() {
        var tbody = document.getElementById('aylikIzinKayitlariBody');
        var sayac = document.getElementById('aylikIzinKayitSayisi');
        var kayitlar = aylikIzinKayitlari.map(function(izin) {
            var personelVerisi = calismaVerileri[izin.personelId] || {};
            var izinTipi = personelVerisi[izin.gun] || izin.izinTipi;
            return {
                gun: izin.gun,
                personelId: izin.personelId,
                personelAdi: (izin.ad + ' ' + izin.soyad).trim(),
                perNo: izin.perNo,
                izinTipi: izinTipi,
                aciklama: personelVerisi['aciklama_' + izin.gun] || izin.aciklama || ''
            };
        });
        kayitlar = kayitlar.filter(function(izin) {
            return izinTurleri.indexOf(izin.izinTipi) >= 0;
        });

        Object.keys(degisenler).forEach(function(personelId) {
            Object.keys(degisenler[personelId]).forEach(function(gunAnahtari) {
                var gun = parseInt(gunAnahtari, 10);
                var zatenListede = aylikIzinKayitlari.some(function(izin) {
                    return String(izin.personelId) === String(personelId) && izin.gun === gun;
                });
                var izinTipi = degisenler[personelId][gunAnahtari];
                if (zatenListede || izinTurleri.indexOf(izinTipi) < 0) return;

                var personel = getPersonelBilgisi(personelId) || {};
                var personelVerisi = calismaVerileri[personelId] || {};
                kayitlar.push({
                    gun: gun,
                    personelId: personelId,
                    personelAdi: ((personel.ad || '') + ' ' + (personel.soyad || '')).trim(),
                    perNo: personel.perNo || '',
                    izinTipi: izinTipi,
                    aciklama: personelVerisi['aciklama_' + gun] || ''
                });
            });
        });

        kayitlar.sort(function(a, b) {
            return a.gun - b.gun || a.personelAdi.localeCompare(b.personelAdi, 'tr-TR');
        });
        sayac.textContent = kayitlar.length + ' kayıt';
        tbody.replaceChildren();

        if (kayitlar.length === 0) {
            var bosSatir = tbody.insertRow();
            var bosHucre = bosSatir.insertCell();
            bosHucre.colSpan = 5;
            bosHucre.className = 'text-center text-muted';
            bosHucre.textContent = 'Seçili ayda izin kaydı bulunmuyor.';
            return;
        }

        kayitlar.forEach(function(kayit) {
            var satir = tbody.insertRow();
            satir.insertCell().textContent = String(kayit.gun).padStart(2, '0') + '.' +
                String(currentMonth).padStart(2, '0') + '.' + currentYear;
            satir.insertCell().textContent = kayit.perNo || kayit.personelId;
            satir.insertCell().textContent = kayit.personelAdi || 'Personel bilgisi bulunamadı';
            satir.insertCell().textContent = kayit.izinTipi;
            satir.insertCell().textContent = kayit.aciklama;
        });
    }
    function changeMonth(offset) {
        if (isSaving) {
            showToast('Kayıt işlemi tamamlanınca ayı değiştirebilirsiniz','warning');
            return;
        }
        if (Object.keys(degisenler).length > 0) {
            if (autoSaveTimer) {
                clearTimeout(autoSaveTimer);
                autoSaveTimer = null;
            }
            saveChanges(false).then(function(saved) {
                if (!saved) return;
                if (Object.keys(degisenler).length > 0) {
                    changeMonth(offset);
                    return;
                }
                changeMonthNow(offset);
            });
            return;
        }
        changeMonthNow(offset);
    }
    function changeMonthNow(offset) {
        currentMonth += offset;
        if (currentMonth > 12) { currentMonth = 1; currentYear++; }
        else if (currentMonth < 1) { currentMonth = 12; currentYear--; }
        document.getElementById('monthTitle').textContent = getMonthName(currentMonth) + ' ' + currentYear;
        loadIzinler();
    }
    function getFilteredPersoneller() {
        var arama = personelAramaMetni.trim().toLocaleLowerCase('tr-TR');
        return personeller.filter(function(p) {
            var statuEslesiyor = seciliStatu === '__TUMU__' || p.statu === seciliStatu;
            var adSoyad = (p.ad + ' ' + p.soyad).toLocaleLowerCase('tr-TR');
            return statuEslesiyor && (!arama || adSoyad.indexOf(arama) >= 0);
        });
    }

    function populateStatuOptions() {
        var select = document.getElementById('statuSelect');
        var statuler = Array.from(new Set(personeller.map(function(p) { return (p.statu || '').trim(); }).filter(Boolean)));
        statuler.sort(function(a, b) { return a.localeCompare(b, 'tr-TR'); });

        select.innerHTML = '<option value="__TUMU__">Tüm Personeller</option>';
        statuler.forEach(function(statu) {
            var option = document.createElement('option');
            option.value = statu;
            option.textContent = statu;
            select.appendChild(option);
        });

        if (statuler.indexOf(seciliStatu) === -1) seciliStatu = '__TUMU__';
        select.value = seciliStatu;
    }

    function calculateHakkedis(pid) {
        var izinGunleri = 0, data = calismaVerileri[pid] || {};
        for (var g = 1; g <= 30; g++) {
            var d = data[g];
            if (d && izinTurleri.indexOf(d) >= 0) izinGunleri++;
        }
        return 30 - izinGunleri;
    }

    // ============================================================
    // KİLİT POPUP
    // ============================================================
    function showKilitPopup(msg) {
        document.getElementById('kilitPopupMesaj').textContent = msg;
        document.getElementById('kilitPopupOverlay').classList.add('active');
    }
    function kilitPopupKapat() {
        document.getElementById('kilitPopupOverlay').classList.remove('active');
    }

    // ============================================================
    // TOAST
    // ============================================================
    function showToast(msg, type) {
        type = type || 'info';
        var c = document.getElementById('toastContainer');
        var t = document.createElement('div');
        t.className = 'toast-item ' + type;
        var icon = type==='success'?'✅':type==='error'?'❌':type==='warning'?'⚠️':'ℹ️';
        t.innerHTML = '<span>'+icon+'</span><span>'+msg+'</span>';
        c.appendChild(t);
        setTimeout(function(){ t.style.animation='fadeOut 0.3s ease'; setTimeout(function(){t.remove();},300); },3500);
    }

    // ============================================================
    // VERİ YÜKLEME
    // ============================================================
    function loadPersoneller() {
        fetch('/Puantaj/GetPersoneller?birim=' + encodeURIComponent(seciliBirim))
            .then(function(r){return r.json();})
            .then(function(data){
                if (data.hata) { showToast('Hata: '+data.hata,'error'); return; }
                personeller = data;
                populateStatuOptions();
                loadIzinler();
            })
            .catch(function(){ showToast('Personel verisi alınamadı','error'); });
    }

    function loadIzinler() {
        var yil = currentYear;
        var ay = currentMonth;
        var yuklemeNo = ++izinYuklemeNo;
        document.getElementById('aylikIzinKayitSayisi').textContent = '...';
        document.getElementById('aylikIzinKayitlariBody').innerHTML =
            '<tr><td colspan="5" class="text-center text-muted">Veriler yükleniyor...</td></tr>';
        fetch('/Puantaj/GetIzinler?yil='+yil+'&ay='+ay)
            .then(function(r){return r.json();})
            .then(function(data){
                if (yuklemeNo !== izinYuklemeNo) return;
                if (data.hata) {
                    document.getElementById('aylikIzinKayitSayisi').textContent = 'Hata';
                    document.getElementById('aylikIzinKayitlariBody').innerHTML =
                        '<tr><td colspan="5" class="text-center text-danger">Puantaj verisi alınamadı.</td></tr>';
                    showToast('Hata: '+data.hata,'error');
                    return;
                }
                calismaVerileri = {};
                izinPersonelBilgileri = {};
                aylikIzinKayitlari = data;
                for (var idx=0; idx<data.length; idx++) {
                    var iz = data[idx];
                    if (!calismaVerileri[iz.personelId]) calismaVerileri[iz.personelId] = {};
                    calismaVerileri[iz.personelId][iz.gun] = iz.izinTipi;
                    if (iz.aciklama) calismaVerileri[iz.personelId]['aciklama_'+iz.gun] = iz.aciklama;
                    izinPersonelBilgileri[iz.personelId] = {
                        personelId: iz.personelId,
                        perNo: iz.perNo,
                        ad: iz.ad,
                        soyad: iz.soyad
                    };
                }
                degisenler = {};
                document.getElementById('aylikIzinKayitSayisi').textContent = '0 kayıt';
                renderTable();
                showToast(getMonthName(ay)+' '+yil+' puantaj verileri yüklendi','info');
            })
            .catch(function(){
                if (yuklemeNo === izinYuklemeNo) {
                    document.getElementById('aylikIzinKayitSayisi').textContent = 'Hata';
                    document.getElementById('aylikIzinKayitlariBody').innerHTML =
                        '<tr><td colspan="5" class="text-center text-danger">Puantaj verisi alınamadı.</td></tr>';
                    showToast('Puantaj verisi alınamadı','error');
                }
            });
    }

    // ============================================================
    // KAYDET
    // ============================================================
    function saveChanges(showMsg) {
        if (Object.keys(degisenler).length === 0) {
            if (showMsg) showToast('Kaydedilecek değişiklik yok','info');
            return Promise.resolve(true);
        }
        if (isSaving) return Promise.resolve(false);

        isSaving = true;
        var kaydedilenler = {};
        var izinler = [];
        for (var pid in degisenler) {
            kaydedilenler[pid] = {};
            for (var gun in degisenler[pid]) {
                var durum = degisenler[pid][gun];
                kaydedilenler[pid][gun] = durum;
                var aciklama = (calismaVerileri[pid] && calismaVerileri[pid]['aciklama_'+gun]) || '';
                izinler.push({
                    PersonelId: pid,
                    Yil: currentYear,
                    Ay: currentMonth,
                    Gun: parseInt(gun),
                    IzinTipi: durum,
                    Aciklama: aciklama
                });
            }
        }
        var kaydetmeBasarili = false;
        return fetch('/Puantaj/KaydetIzin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(izinler)
        })
        .then(function(r){return r.json();})
        .then(function(data){
            if (data.basarili) {
                kaydetmeBasarili = true;
                if (showMsg) showToast('✅ ' + data.mesaj, 'success');
                for (var pid in kaydedilenler) {
                    for (var gun in kaydedilenler[pid]) {
                        if (degisenler[pid] && degisenler[pid][gun] === kaydedilenler[pid][gun]) {
                            delete degisenler[pid][gun];
                        }
                    }
                    if (degisenler[pid] && Object.keys(degisenler[pid]).length === 0) delete degisenler[pid];
                }
                return true;
            } else {
                if (data.mesaj && data.mesaj.indexOf('kilitlenmiş') > -1) {
                    showKilitPopup(data.mesaj);
                } else {
                    showToast('Hata: ' + data.mesaj, 'error');
                }
                return false;
            }
        })
        .catch(function(){ showToast('Kaydetme hatası','error'); return false; })
        .finally(function() {
            isSaving = false;
            if (kaydetmeBasarili && Object.keys(degisenler).length > 0) scheduleAutoSave();
        });
    }

    function updateDurum(pid, gun, yeniDurum, aciklama) {
        if (!calismaVerileri[pid]) calismaVerileri[pid] = {};
        var eski = calismaVerileri[pid][gun];
        if (eski === yeniDurum) return false;
        calismaVerileri[pid][gun] = yeniDurum;
        if (aciklama) calismaVerileri[pid]['aciklama_'+gun] = aciklama;
        if (!degisenler[pid]) degisenler[pid] = {};
        degisenler[pid][gun] = yeniDurum;
        return true;
    }

    // ============================================================
    // OTOMATİK KAYDETME
    // ============================================================
    function scheduleAutoSave() {
        if (autoSaveTimer) clearTimeout(autoSaveTimer);
        if (Object.keys(degisenler).length > 0) {
            autoSaveTimer = setTimeout(function(){ saveChanges(false); autoSaveTimer=null; }, 500);
        }
    }

    // ============================================================
    // TOPLU İZİN
    // ============================================================
    function openBatchModal() {
        var sel = document.getElementById('batchPersonelSelect');
        sel.innerHTML = '';
        getFilteredPersoneller().forEach(function(p) {
            var opt = document.createElement('option');
            opt.value = p.personelId;
            opt.textContent = p.ad + ' ' + p.soyad + ' (' + p.birim + ')';
            sel.appendChild(opt);
        });
        var defDate = currentYear + '-' + String(currentMonth).padStart(2,'0') + '-01';
        var maxDay = Math.min(30, new Date(currentYear, currentMonth, 0).getDate());
        document.getElementById('baslangicTarih').value = defDate;
        document.getElementById('bitisTarih').value = currentYear+'-'+String(currentMonth).padStart(2,'0')+'-'+String(maxDay).padStart(2,'0');
        document.getElementById('batchAciklama').value = '';
        document.getElementById('batchModal').classList.add('active');
    }

    function closeBatchModal() {
        document.getElementById('batchModal').classList.remove('active');
    }

    function saveBatchIzin() {
        var opts = document.getElementById('batchPersonelSelect').selectedOptions;
        var pids = Array.from(opts).map(function(o){return o.value;});
        var bas = new Date(document.getElementById('baslangicTarih').value);
        var bit = new Date(document.getElementById('bitisTarih').value);
        var tip = document.getElementById('batchIzinTipi').value;
        var acik = document.getElementById('batchAciklama').value;
        if (pids.length===0) { showToast('Personel seçin','warning'); return; }
        if (isNaN(bas)||isNaN(bit)) { showToast('Geçerli tarih girin','warning'); return; }
        var eklenen = 0;
        var gunler = [];
        for (var d=new Date(bas); d<=bit; d.setDate(d.getDate()+1)) {
            if (d.getMonth()+1===currentMonth && d.getDate()>=1 && d.getDate()<=30) gunler.push(d.getDate());
        }
        pids.forEach(function(pid) {
            gunler.forEach(function(gun) {
                if (updateDurum(pid, gun, tip, acik)) eklenen++;
            });
        });
        if (eklenen>0) {
            renderTable();
            showToast(eklenen+' kayıt eklendi','success');
            scheduleAutoSave();
        } else {
            showToast('Yeni kayıt yok','info');
        }
        closeBatchModal();
    }

    // ============================================================
    // TABLO OLUŞTURMA
    // ============================================================
    function renderTable() {
        renderIzinKayitlari();
        var filtered = getFilteredPersoneller();
        var gunSayisi = 30;
        var today = new Date();
        var isCurrentMonth = (currentYear === today.getFullYear() && currentMonth === (today.getMonth() + 1));
        var todayDay = today.getDate();

        // --- HEADER ---
        var hdr = '<tr><th class="col-personel" style="position:sticky;left:0;z-index:25;">Personel</th>';
        for (var i=1; i<=gunSayisi; i++) {
            var wk = isWeekend(currentYear,currentMonth,i);
            var cls = '';
            var style = '';
            if (wk) cls += ' weekend';
            if (isCurrentMonth && i === todayDay) cls += ' today-col';
            hdr += '<th class="col-gun'+cls+'"'+style+'>'+i+'</th>';
        }
        hdr += '<th class="col-sayac">X</th><th class="col-sayac">İ</th><th class="col-sayac">H</th><th class="col-hakkedis">Hakediş</th></tr>';
        document.getElementById('tableHeader').innerHTML = hdr;

        // --- BODY ---
        var body = '';
        filtered.forEach(function(p) {
            var tX=0, tI=0, tH=0;
            body += '<tr data-personel-id="'+p.personelId+'">';
            body += '<td class="col-personel-sticky">'+p.ad+' '+p.soyad+'</td>';
            for (var gun=1; gun<=gunSayisi; gun++) {
                var durum = (calismaVerileri[p.personelId] && calismaVerileri[p.personelId][gun]) || 'X';
                var cls = 'durum-' + getDurumClass(durum);
                var disp = getDurumDisplay(durum);
                if (durum==='X') tX++;
                else if (durum==='H') tH++;
                else if (izinTurleri.indexOf(durum)>=0) tI++;
                var wk = isWeekend(currentYear,currentMonth,gun);
                var extraCls = '';
                if (wk) extraCls += ' weekend';
                if (isCurrentMonth && gun === todayDay) extraCls += ' today-col';
                body += '<td class="durum-cell '+cls+extraCls+'" data-gun="'+gun+'" data-personel="'+p.personelId+'" onclick="openModal(\''+p.personelId+'\','+gun+',\''+durum.replace(/'/g,"\\'")+'\')">'+disp+'</td>';
            }
                var hak = calculateHakkedis(p.personelId);
            var hakCls = hak >= 28 ? 'hakkedis-good' : (hak >= 25 ? 'hakkedis-mid' : 'hakkedis-low');
            body += '<td class="total-cell col-sayac">'+tX+'</td>';
            body += '<td class="total-cell col-sayac">'+tI+'</td>';
            body += '<td class="total-cell col-sayac">'+tH+'</td>';
            body += '<td class="hakkedis-cell '+hakCls+' col-hakkedis">'+hak+'</td>';
            body += '</tr>';
        });
        document.getElementById('tableBody').innerHTML = body;
        document.getElementById('totalPersonel').innerText = filtered.length;
        document.getElementById('birimBadge').innerHTML = '🏢 '+(seciliBirim==='all'?'Tüm Birimler':seciliBirim);
    }

    // ============================================================
    // LEGEND
    // ============================================================
    function toggleLegend() {
        var panel = document.getElementById('legendPanel');
        var btn = document.getElementById('legendToggleBtn');
        if (panel.style.display === 'none') {
            panel.style.display = 'flex';
            btn.textContent = '🎨 Renk Açıklamaları ▲';
        } else {
            panel.style.display = 'none';
            btn.textContent = '🎨 Renk Açıklamaları ▼';
        }
    }

    // ============================================================
    // MODAL
    // ============================================================
    var modalPersonelId = null, modalGun = null;

    function openModal(pid, gun, cur) {
        modalPersonelId = pid;
        modalGun = gun;
        var adi = getPersonelAdi(pid);
        document.getElementById('modalPersonelInfo').textContent = '👤 ' + adi;
        document.getElementById('modalTarihInfo').textContent = '📅 ' + gun + ' ' + getMonthName(currentMonth) + ' ' + currentYear;
        document.getElementById('modalDurum').value = cur;
        document.getElementById('modalAciklama').value = (calismaVerileri[pid] && calismaVerileri[pid]['aciklama_'+gun]) || '';
        document.getElementById('editModal').classList.add('active');
    }

    function closeModal() {
        document.getElementById('editModal').classList.remove('active');
    }

    function saveModal() {
        var dur = document.getElementById('modalDurum').value;
        var acik = document.getElementById('modalAciklama').value;
        if (updateDurum(modalPersonelId, modalGun, dur, acik)) {
            renderTable();
            showToast(getPersonelAdi(modalPersonelId) + ' - ' + modalGun + ' günü ' + getDurumDisplay(dur), 'success');
            scheduleAutoSave();
        }
        closeModal();
    }

    // ============================================================
    // KLAVYE
    // ============================================================
    document.addEventListener('keydown', function(e) {
        var t = e.target;
        if (t.classList && t.classList.contains('durum-cell')) {
            var pid = t.dataset.personel, gun = parseInt(t.dataset.gun), nd = null;
            var key = e.key.toUpperCase();
            if (key==='X') nd='X';
            else if (key==='İ'||key==='I') nd='İ';
            else if (key==='G') nd='Gİ';
            else if (key==='Ç'||key==='C') nd='ÇH';
            else if (key==='V') nd='Vİ';
            else if (key==='Ö'||key==='O') nd='Öİ';
            else if (key==='H') nd='H';
            if (nd) {
                e.preventDefault();
                if (updateDurum(pid, gun, nd)) {
                    renderTable();
                    showToast(getPersonelAdi(pid) + ' - ' + gun + ' günü ' + getDurumDisplay(nd), 'info');
                    scheduleAutoSave();
                }
            }
        }
        if (e.ctrlKey && e.key==='s') { e.preventDefault(); saveChanges(true); }
    });

    // ============================================================
    // DIŞA AKTAR
    // ============================================================
    function openCiktiPage() {
        if (Object.keys(degisenler).length > 0) saveChanges(false);
        var url = '/Puantaj/Cikti?yil='+currentYear+'&ay='+currentMonth+'&birim='+encodeURIComponent(seciliBirim);
        window.open(url, '_blank');
    }

    function downloadPuantajPdf() {
        if (Object.keys(degisenler).length > 0) saveChanges(false);
        var url = '/Puantaj/Pdf?yil='+currentYear+
            '&ay='+currentMonth+
            '&birim='+encodeURIComponent(seciliBirim)+
            '&statu='+encodeURIComponent(seciliStatu)+
            '&arama='+encodeURIComponent(personelAramaMetni);
        window.open(url, '_blank');
    }

    function previewPuantajReport() {
        if (Object.keys(degisenler).length > 0) saveChanges(false);
        var url = '/Puantaj/Preview?yil='+currentYear+
            '&ay='+currentMonth+
            '&birim='+encodeURIComponent(seciliBirim)+
            '&statu='+encodeURIComponent(seciliStatu)+
            '&arama='+encodeURIComponent(personelAramaMetni);
        var width = Math.min(1400, screen.availWidth - 40);
        var height = Math.min(900, screen.availHeight - 60);
        var left = Math.max(0, Math.round((screen.availWidth - width) / 2));
        var top = Math.max(0, Math.round((screen.availHeight - height) / 2));
        window.open(url, 'PuantajFastReportPreview', 'popup=yes,width='+width+',height='+height+',left='+left+',top='+top+',resizable=yes,scrollbars=yes');
    }

    // ============================================================
    // OLAY DİNLEYİCİLER
    // ============================================================
    document.getElementById('previousMonthBtn').addEventListener('click', function() { changeMonth(-1); });
    document.getElementById('nextMonthBtn').addEventListener('click', function() { changeMonth(1); });

    // ✅ BİRİM DROPDOWN DEĞİŞİNCE VERİYİ YENİLE
    document.getElementById('birimSelect')?.addEventListener('change', function(e) {
        seciliBirim = e.target.value;
        loadPersoneller();
    });

    document.getElementById('statuSelect').addEventListener('change', function(e) {
        seciliStatu = e.target.value;
        renderTable();
    });
    document.getElementById('personelArama').addEventListener('input', function(e) {
        personelAramaMetni = e.target.value;
        renderTable();
    });

    document.getElementById('saveBtn').addEventListener('click', function(){ saveChanges(true); });
    document.getElementById('exportBtn').addEventListener('click', openCiktiPage);
    document.getElementById('previewBtn').addEventListener('click', previewPuantajReport);
    document.getElementById('pdfExportBtn').addEventListener('click', downloadPuantajPdf);
    document.getElementById('batchIzinBtn').addEventListener('click', openBatchModal);
    document.getElementById('legendToggleBtn').addEventListener('click', toggleLegend);

    // Modalları dışarı tıklayınca kapat
    document.getElementById('editModal').addEventListener('click', function(e){ if(e.target===this) closeModal(); });
    document.getElementById('batchModal').addEventListener('click', function(e){ if(e.target===this) closeBatchModal(); });
    document.getElementById('kilitPopupOverlay').addEventListener('click', function(e){ if(e.target===this) kilitPopupKapat(); });

    // Sayfa kapanmadan kaydet
    window.addEventListener('beforeunload', function() {
        if (Object.keys(degisenler).length > 0) saveChanges(false);
    });

    // ============================================================
    // BAŞLANGIÇ
    // ============================================================
    loadPersoneller();
</script>