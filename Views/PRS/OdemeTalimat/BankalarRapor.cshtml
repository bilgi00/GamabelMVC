@model FastReport.Web.WebReport
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Banka / Ödeme Hesabı Raporu</title>
    <style>
        html, body { margin: 0; padding: 0; height: 100%; font-family: Arial, sans-serif; }
        .rapor-cubuk { height: 48px; line-height: 48px; padding: 0 12px; background: #f1f3f5; font-size: 13px; }
        .rapor-cubuk a { margin-right: 14px; text-decoration: none; color: #0b5ed7; }
        .rapor-cubuk strong { margin-right: 10px; }
    </style>
</head>
<body>
    <div class="rapor-cubuk">
        <strong>Banka / Ödeme Hesabı — Yatay</strong>
        <a asp-controller="OdemeTalimat" asp-action="BankalarRaporPdf">PDF indir</a>
        <a asp-controller="OdemeTalimat" asp-action="Bankalar">Banka yönetimine dön</a>
    </div>
    @await Model.Render()
</body>
</html>
