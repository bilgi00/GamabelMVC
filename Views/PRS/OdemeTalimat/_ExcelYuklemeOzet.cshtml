@model gamabelmvc.Models.PRS.ExcelYuklemeOzetViewModel

<style>
    .excel-summary { margin: 0 0 20px; padding: 18px; border: 1px solid #a7f3d0; border-radius: 12px; background: #f0fdf4; color: #14532d; }
    .excel-summary-header { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
    .excel-summary-icon { display: grid; place-items: center; flex: 0 0 38px; height: 38px; border-radius: 50%; background: #dcfce7; font-size: 20px; }
    .excel-summary-header h2 { margin: 0 0 3px; color: #166534; font-size: 17px; }
    .excel-summary-header p { margin: 0; color: #4b6353; font-size: 13px; }
    .excel-summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 10px; }
    .excel-summary-stat { min-height: 78px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 9px; background: #fff; }
    .excel-summary-stat strong { display: block; margin-bottom: 4px; color: #1e293b; font-size: 22px; line-height: 1.2; }
    .excel-summary-stat span { color: #64748b; font-size: 12px; }
    .excel-summary-stat-added { border-color: #86efac; background: #f7fef8; }
    .excel-summary-stat-added strong { color: #15803d; }
    .excel-summary-matches { margin-top: 14px; padding-top: 13px; border-top: 1px solid #d1fae5; }
    .excel-summary-matches h3 { margin: 0 0 9px; color: #334155; font-size: 13px; }
    .excel-summary-match-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .excel-summary-match { display: inline-block; padding: 6px 10px; border: 1px solid #fde68a; border-radius: 7px; background: #fffbeb; color: #854d0e; font-size: 12px; overflow-wrap: anywhere; }
    .excel-summary-duplicates { margin-top: 14px; padding-top: 13px; border-top: 1px solid #e2e8f0; }
    .excel-summary-duplicates h3 { margin: 0 0 9px; color: #334155; font-size: 13px; }
    .excel-summary-duplicate-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .excel-summary-duplicate { display: inline-block; padding: 6px 10px; border: 1px solid #fdba74; border-radius: 7px; background: #fff7ed; color: #9a3412; font-size: 12px; overflow-wrap: anywhere; }
    .excel-summary-more { align-self: center; color: #64748b; font-size: 12px; }

    @@media (max-width: 576px) {
        .excel-summary { padding: 14px; }
        .excel-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
</style>

<section class="excel-summary" role="status" aria-labelledby="excel-summary-title">
    <div class="excel-summary-header">
        <span class="excel-summary-icon" aria-hidden="true">✓</span>
        <div>
            <h2 id="excel-summary-title">Excel yükleme özeti</h2>
            <p>Satırların sisteme aktarım durumu</p>
        </div>
    </div>

    <div class="excel-summary-grid">
        <div class="excel-summary-stat">
            <strong>@Model.ExcelSatirSayisi</strong>
            <span>Excel fatura satırı</span>
        </div>
        <div class="excel-summary-stat excel-summary-stat-added">
            <strong>@Model.Eklenen</strong>
            <span>Yeni eklenen</span>
        </div>
        <div class="excel-summary-stat">
            <strong>@Model.CiftIslemSayisi</strong>
            <span>Çift / tekrar satır</span>
        </div>
        <div class="excel-summary-stat">
            <strong>@Model.OdenmisIslemSayisi</strong>
            <span>Zaten ödenmiş</span>
        </div>
        <div class="excel-summary-stat">
            <strong>@Model.MevcutAcikIslemSayisi</strong>
            <span>Sistemde açık olduğu için atlanan</span>
        </div>
    </div>

    @if (Model.CiftFaturalar.Count > 0)
    {
        <div class="excel-summary-duplicates">
            <h3>Tekrar bulunan faturalar</h3>
            <div class="excel-summary-duplicate-list">
                @foreach (var fatura in Model.CiftFaturalar)
                {
                    <span class="excel-summary-duplicate">@fatura</span>
                }
            </div>
        </div>
    }

    @if (Model.OdenmisFaturalar.Count > 0)
    {
        <div class="excel-summary-matches">
            <h3>Zaten ödenmiş faturalar</h3>
            <div class="excel-summary-match-list">
                @foreach (var fatura in Model.OdenmisFaturalar)
                {
                    <span class="excel-summary-match">@fatura</span>
                }
                @if (Model.EkOdenmisFaturaSayisi > 0)
                {
                    <span class="excel-summary-more">+@Model.EkOdenmisFaturaSayisi kayıt daha</span>
                }
            </div>
        </div>
    }
</section>
