@model List<gamabelmvc.Models.PRS.OtFirma>
@{
    ViewData["Title"] = "Firma Yönetimi";
}

<style>
    .ot-header { background: linear-gradient(135deg, #1e3c72, #2a5298); color: white; padding: 18px 22px; border-radius: 12px 12px 0 0; }
    .ot-card { background: white; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); overflow: hidden; margin-bottom: 24px; }
    .ot-card-body { padding: 20px; }
    .ot-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 13px; font-weight: 600; border-radius: 8px; text-decoration: none; border: none; cursor: pointer; transition: all 0.2s; }
    .ot-btn-primary { background: linear-gradient(135deg, #1e3c72, #2a5298); color: white; }
    .ot-btn-danger { background: #dc3545; color: white; }
    .ot-btn-secondary { background: #6c757d; color: white; }
    .ot-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .ot-table th { background: #f1f5f9; padding: 8px 12px; text-align: left; font-weight: 600; border-bottom: 2px solid #dee2e6; }
    .ot-table td { padding: 8px 12px; border-bottom: 1px solid #f0f0f0; vertical-align: middle; }
    .ot-table tbody tr:hover { background: #f8f9fa; }
    .form-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; padding: 16px; background: #f8faff; border-radius: 8px; margin-bottom: 20px; border: 1px solid #dbeafe; }
    .form-row input { padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; }
    .form-row label { font-size: 12px; font-weight: 600; color: #374151; display: block; margin-bottom: 4px; }
    .alert-hata { background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
    .modal-overlay { position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(15,23,42,0.55); display:flex; align-items:center; justify-content:center; z-index:1000; }
    .modal-card { background:white; border-radius:14px; width:min(96%,540px); max-width:540px; box-shadow:0 24px 80px rgba(15,23,42,0.18); overflow:hidden; }
    .modal-header { display:flex; align-items:center; justify-content:space-between; padding:18px 20px; border-bottom:1px solid #e2e8f0; }
    .modal-header h2 { margin:0; font-size:16px; }
    .modal-close { appearance:none; border:none; background:transparent; font-size:24px; line-height:1; cursor:pointer; color:#374151; }
    .modal-body { padding:20px; display:grid; gap:14px; }
    .modal-body label { display:block; font-size:13px; font-weight:700; color:#1e293b; margin-bottom:6px; }
    .modal-body input { width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:8px; font-size:14px; }
    .modal-actions { display:flex; gap:10px; justify-content:flex-end; padding:16px 20px 20px; }
</style>

<div style="margin-bottom:12px;">
    <a href="/OdemeTalimat" class="ot-btn ot-btn-secondary">← Ödeme Talimatlarına Dön</a>
</div>

<div class="ot-card">
    <div class="ot-header">
        <h1 style="font-size:18px; margin:0;">🏢 Firma Yönetimi</h1>
    </div>
    <div class="ot-card-body">

        @if (TempData["Hata"] != null)
        {
            <div class="alert-hata">❌ @TempData["Hata"]</div>
        }

        <!-- Yeni Firma Ekleme Formu -->
        <form method="post" asp-controller="OdemeTalimat" asp-action="FirmaKaydet">
            <input type="hidden" name="Id" value="0" />
            <div class="form-row">
                <div>
                    <label>Cari İsmi (Faturadaki isim) *</label>
                    <input type="text" name="CariIsmi" required placeholder="örn: ABC TİCARET A.Ş." style="width:220px;" />
                </div>
                <div>
                    <label>Ödeme İsmi (Alıcı adı)</label>
                    <input type="text" name="OdemeIsmi" placeholder="IBAN sahibi isim" style="width:220px;" />
                </div>
                <div>
                    <label>IBAN *</label>
                    <input type="text" name="IBAN" required placeholder="TR..." maxlength="35" style="width:230px; font-family:monospace;" />
                </div>
                <div>
                    <label>Açıklama</label>
                    <input type="text" name="Aciklama" placeholder="(opsiyonel)" style="width:160px;" />
                </div>
                <div>
                    <label>Email</label>
                    <input type="email" name="Email" placeholder="firma@ornek.com" style="width:220px;" />
                </div>
                <div>
                    <label>CC</label>
                    <input type="text" name="EmailCc" placeholder="cc1@ornek.com,cc2@ornek.com" style="width:220px;" />
                </div>
                <div>
                    <button type="submit" class="ot-btn ot-btn-primary">➕ Ekle</button>
                </div>
            </div>
        </form>

        <!-- Firma Listesi -->
        @if (!Model.Any())
        {
            <p style="color:#6c757d; font-size:13px;">Henüz firma tanımlı değil.</p>
        }
        else
        {
            <table class="ot-table">
                <thead>
                    <tr>
                        <th>Cari İsmi</th>
                        <th>Ödeme İsmi</th>
                        <th>IBAN</th>
                        <th>Email</th>
                        <th>Açıklama</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td>@f.CariIsmi</td>
                            <td>@f.OdemeIsmi</td>
                            <td style="font-family:monospace; font-size:12px;">@f.IBAN</td>
                            <td style="color:#6c757d;">@(!string.IsNullOrWhiteSpace(f.Email) ? f.Email : "—")</td>
                            <td style="color:#6c757d;">@(f.Aciklama ?? "—")</td>
                            <td style="display:flex; gap:8px; justify-content:flex-end;">
                                <a href="/MailGonder?firmaId=@f.Id" class="ot-btn ot-btn-secondary" style="padding:5px 12px; font-size:12px;">✉ Mail Gönder</a>
                                <button type="button" class="ot-btn ot-btn-secondary" style="padding:5px 12px; font-size:12px;"
                                    onclick="openFirmaEditModal(@f.Id, '@Html.Raw(f.CariIsmi.Replace("'", "\\'").Replace("\"", "\\\""))', '@Html.Raw((f.OdemeIsmi ?? string.Empty).Replace("'", "\\'").Replace("\"", "\\\""))', '@Html.Raw(f.IBAN.Replace("'", "\\'").Replace("\"", "\\\""))', '@Html.Raw((f.Aciklama ?? string.Empty).Replace("'", "\\'").Replace("\"", "\\\""))', '@Html.Raw((f.Email ?? string.Empty).Replace("'", "\\'").Replace("\"", "\\\""))', '@Html.Raw((f.EmailCc ?? string.Empty).Replace("'", "\\'").Replace("\"", "\\\""))')">
                                    ✏ Düzenle
                                </button>
                                <form method="post" asp-controller="OdemeTalimat" asp-action="FirmaSil"
                                      onsubmit="return confirm('@f.CariIsmi silinsin mi?')">
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <button type="submit" class="ot-btn ot-btn-danger" style="padding:5px 12px; font-size:12px;">🗑 Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="firmaEditModal" class="modal-overlay" style="display:none;">
                <div class="modal-card">
                    <div class="modal-header">
                        <h2>Firma Düzenle</h2>
                        <button type="button" class="modal-close" onclick="closeFirmaEditModal()">×</button>
                    </div>
                    <form method="post" asp-controller="OdemeTalimat" asp-action="FirmaKaydet">
                        <input type="hidden" id="editFirmaId" name="Id" value="0" />
                        <div class="modal-body">
                            <label>Cari İsmi *</label>
                            <input type="text" id="editCariIsmi" name="CariIsmi" required />
                            <label>Ödeme İsmi</label>
                            <input type="text" id="editOdemeIsmi" name="OdemeIsmi" />
                            <label>IBAN *</label>
                            <input type="text" id="editIBAN" name="IBAN" required maxlength="35" />
                            <label>Açıklama</label>
                            <input type="text" id="editAciklama" name="Aciklama" />
                            <label>Email</label>
                            <input type="email" id="editEmail" name="Email" />
                            <label>CC</label>
                            <input type="text" id="editEmailCc" name="EmailCc" />
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="ot-btn ot-btn-secondary" onclick="closeFirmaEditModal()">Vazgeç</button>
                            <button type="submit" class="ot-btn ot-btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function openFirmaEditModal(id, cariIsmi, odemeIsmi, iban, aciklama, email, emailCc) {
        document.getElementById('editFirmaId').value = id;
        document.getElementById('editCariIsmi').value = cariIsmi || '';
        document.getElementById('editOdemeIsmi').value = odemeIsmi || '';
        document.getElementById('editIBAN').value = iban || '';
        document.getElementById('editAciklama').value = aciklama || '';
        document.getElementById('editEmail').value = email || '';
        document.getElementById('editEmailCc').value = emailCc || '';
        document.getElementById('firmaEditModal').style.display = 'flex';
    }

    function closeFirmaEditModal() {
        document.getElementById('firmaEditModal').style.display = 'none';
    }
</script>
}

