@model gamabelmvc.Models.PRS.ManuelTalimatModel
@using gamabelmvc.Models.PRS

@{
    ViewData["Title"] = "Manuel Kayıt";
    var bankalar = ViewBag.Bankalar as List<OtBanka> ?? new List<OtBanka>();
    var firmalar = ViewBag.Firmalar as List<OtFirma> ?? new List<OtFirma>();
    if (Model.Satirlar.Count == 0)
    {
        Model.Satirlar.Add(new());
    }
}

<link rel="stylesheet" href="~/css/odemetalimat.css" asp-append-version="true" />

<div class="ot-card">
    <div class="ot-header">
        <h3>✍️ Manuel Kayıt</h3>
        <p>Fatura bilgilerini girin; taslak olarak saklayabilir veya son halinde talimata dönüştürebilirsiniz.</p>
    </div>
    <div class="ot-card-body">
        @if (TempData["Hata"] != null)
        {
            <div class="alert-hata" role="alert">❌ @TempData["Hata"]</div>
        }
        @if (TempData["Bilgi"] != null)
        {
            <div class="alert-bilgi" role="status">ℹ️ @TempData["Bilgi"]</div>
        }
        <div asp-validation-summary="All" class="alert-hata" role="alert"></div>

        @if (!firmalar.Any())
        {
            <div class="alert-hata" role="alert">
                Ödeme alıcısı tanımlı firma bulunamadı. Önce <a asp-controller="OdemeTalimat" asp-action="Firmalar">Firma Yönetimi</a> bölümünden firma ve IBAN bilgisi ekleyin.
            </div>
        }
        @if (!bankalar.Any())
        {
            <div class="alert-hata" role="alert">
                Ödeme hesabı tanımlı banka bulunamadı. Önce <a asp-controller="OdemeTalimat" asp-action="Bankalar">Banka Yönetimi</a> bölümünden banka ekleyin.
            </div>
        }

        <form method="post" asp-controller="OdemeTalimat" asp-action="ManuelTalimatOlustur" id="manuelTalimatForm">
            <input asp-for="TaslakId" type="hidden" />
            <div class="form-panel">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label asp-for="TalimatTarihi" class="form-label fw-semibold">Talimat tarihi</label>
                        <input asp-for="TalimatTarihi" type="date" class="form-control" required />
                        <span asp-validation-for="TalimatTarihi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BankaId" class="form-label fw-semibold">Ödemenin yapılacağı hesap</label>
                        <select asp-for="BankaId" class="form-select" required>
                            <option value="">Banka seçin</option>
                            @foreach (var banka in bankalar)
                            {
                                var iban = banka.IBAN ?? string.Empty;
                                var maskeliIban = iban.Length > 4 ? $"•••• {iban[^4..]}" : iban;
                                <option value="@banka.Id">@banka.SubeAdi — @maskeliIban</option>
                            }
                        </select>
                        <span asp-validation-for="BankaId" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-2">
                <h5 class="mb-0 manuel-heading">Fatura satırları</h5>
                <button type="button" class="btn btn-success" id="addRowBtn">＋ Fatura Ekle</button>
            </div>

            <div class="table-responsive">
                <table class="manuel-table">
                    <thead>
                        <tr>
                            <th style="width:28%;">Ödeme yapılacak firma</th>
                            <th>Fatura adı / numarası</th>
                            <th style="width:20%; text-align:right;">Tutar (TL)</th>
                            <th style="width:48px;"></th>
                        </tr>
                    </thead>
                    <tbody id="invoiceRows">
                        @for (var i = 0; i < Model.Satirlar.Count; i++)
                        {
                            var rowViewData = new ViewDataDictionary(ViewData)
                            {
                                ["RowIndex"] = i,
                                ["IncludeFirmaOptions"] = true
                            };
                            @await Html.PartialAsync("_ManuelFaturaSatiri", Model.Satirlar[i], rowViewData)
                        }
                    </tbody>
                </table>
            </div>
            <div id="duplicateWarning" class="alert-hata duplicate-warning" role="alert" hidden></div>
            <div id="pasteFeedback" class="text-danger small" role="status" aria-live="polite"></div>

            <span asp-validation-for="Satirlar" class="text-danger small"></span>

            <div class="sticky-bar">
                <div>
                    <div class="tutar-ozet" id="toplamTutar" aria-live="polite">Toplam: 0,00 TL</div>
                    <div class="text-muted small" id="faturaSayisi" aria-live="polite">0 fatura</div>
                </div>
                <div class="sticky-actions">
                    <a asp-controller="OdemeTalimat" asp-action="Index" class="btn btn-secondary">← Geri</a>
                    <button type="button" id="saveDraftBtn" class="btn btn-outline-primary">
                        💾 @(Model.TaslakId.HasValue ? "Taslağı Güncelle" : "Taslak Kaydet")
                    </button>
                    <button type="submit" name="islem" value="olustur" class="btn btn-primary" @(!bankalar.Any() || !firmalar.Any() ? "disabled" : "")>
                        💳 Talimat Oluştur ve Kaydet
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<template id="invoiceRowTemplate">
    @{
        var templateViewData = new ViewDataDictionary(ViewData)
        {
            ["RowIndex"] = "__index__",
            ["IncludeFirmaOptions"] = false
        };
    }
    @await Html.PartialAsync("_ManuelFaturaSatiri", new ManuelTalimatSatiriModel(), templateViewData)
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/manuel-kayit.js" asp-append-version="true"></script>
}
