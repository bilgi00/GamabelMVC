@{
    ViewData["Title"] = "Ödeme Talimatı Mail Gönder - v.1";
    var firmalar = ViewBag.Firmalar as List<gamabelmvc.Models.PRS.OtFirma> ?? new();
    var sonTalimatlar = ViewBag.SonTalimatlar as List<gamabelmvc.Models.PRS.OtTalimat> ?? new();
    var seciliTalimat = ViewBag.SeciliTalimat as gamabelmvc.Models.PRS.OtTalimat;
    var kullaniciAdi = ViewBag.KullaniciAdi ?? "";
    var queueCount = ViewBag.QueueCount ?? 0;
    var preFirmaId = (int?)(ViewBag.SeciliFirmaId ?? 0);
}

<style>
    .mail-header { background: linear-gradient(135deg, #1e3c72, #2a5298); color: white; padding: 20px 24px; border-radius: 12px 12px 0 0; }
    .mail-card { background: white; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); overflow: hidden; }
    .mail-card-body { padding: 24px; }
    .firma-list { max-height: 400px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; }
    .firma-item { padding: 8px 12px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 12px; }
    .firma-item:hover { background: #f8fafc; }
    .firma-item input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; }
    .firma-item .firma-bilgi { flex: 1; }
    .firma-item .firma-bilgi .adi { font-weight: 600; font-size: 14px; }
    .firma-item .firma-bilgi .email { font-size: 12px; color: #64748b; }
    .firma-item .firma-bilgi .iban { font-size: 11px; color: #94a3b8; font-family: monospace; }
    .badge-email-var { background: #d1fae5; color: #065f46; padding: 2px 10px; border-radius: 12px; font-size: 11px; }
    .badge-email-yok { background: #fee2e2; color: #991b1b; padding: 2px 10px; border-radius: 12px; font-size: 11px; }
    .btn-mail-gonder { background: linear-gradient(135deg, #1e3c72, #2a5298); color: white; border: none; padding: 10px 32px; border-radius: 8px; font-weight: 600; transition: all 0.2s; }
    .btn-mail-gonder:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(30, 60, 114, 0.3); }
    .btn-select-all { background: #f1f5f9; border: 1px solid #e2e8f0; padding: 6px 16px; border-radius: 6px; font-size: 13px; cursor: pointer; }
    .btn-select-all:hover { background: #e2e8f0; }
    .queue-badge { background: #fef3c7; color: #92400e; padding: 4px 12px; border-radius: 20px; font-size: 12px; }
    .queue-badge .count { font-weight: 700; font-size: 16px; }
    
    /* Talimat detay kartı */
    .talimat-detay { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-top: 12px; }
    .talimat-detay .detay-item { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px dashed #e9edf4; }
    .talimat-detay .detay-item:last-child { border-bottom: none; }
    .talimat-detay .detay-label { font-weight: 600; color: #475569; }
    .talimat-detay .detay-value { font-weight: 500; color: #1e293b; }
    .talimat-detay .fatura-list { max-height: 200px; overflow-y: auto; margin-top: 8px; }
    .talimat-detay .fatura-item { padding: 4px 8px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; font-size: 13px; }
    .talimat-detay .fatura-item:hover { background: #f1f5f9; }
    .talimat-detay .fatura-item .fatura-no { font-weight: 500; }
    .talimat-detay .fatura-item .fatura-tutar { font-weight: 600; color: #1e3c72; }

    /* Firma Gruplama */
    .firma-grup { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; }
    .firma-grup .grup-baslik { background: #f1f5f9; padding: 8px 12px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: 600; font-size: 13px; transition: 0.2s; }
    .firma-grup .grup-baslik:hover { background: #e9edf4; }
    .firma-grup .grup-baslik .grup-icon { transition: 0.3s; }
    .firma-grup .grup-baslik .grup-icon.acik { transform: rotate(90deg); }
    .firma-grup .grup-icerik { display: none; padding: 0 8px; }
    .firma-grup .grup-icerik.acik { display: block; }

    /* Önizleme */
    .preview-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; max-height: 400px; overflow-y: auto; font-size: 13px; }
    .preview-box .preview-placeholder { text-align: center; color: #94a3b8; padding: 40px 0; }
    .preview-box .preview-placeholder i { font-size: 32px; display: block; margin-bottom: 8px; }

    /* Zamanlama */
    .zamanlama-alani { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; }
    .zamanlama-alani .form-label { font-weight: 600; font-size: 13px; color: #475569; }
    .btn-simdi { background: #e9edf4; border: none; border-radius: 6px; padding: 6px 16px; font-size: 12px; font-weight: 500; cursor: pointer; transition: 0.2s; }
    .btn-simdi:hover { background: #d1d9e6; }

    /* Responsive */
    @@media (max-width: 768px) {
        .mail-card-body { padding: 16px; }
        .firma-item { flex-wrap: wrap; gap: 6px; }
        .firma-item .firma-bilgi { width: 100%; }
        .talimat-detay .detay-item { flex-direction: column; gap: 2px; }
        .talimat-detay .fatura-item { font-size: 12px; }
        .btn-mail-gonder { width: 100%; justify-content: center; }
        .d-flex.justify-content-between { flex-direction: column; gap: 10px; align-items: stretch; }
    }
</style>

<div class="container-fluid px-4 py-3">
    <div class="mail-card">
        <div class="mail-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-0"><i class="fas fa-envelope me-2"></i>Ödeme Talimatı Mail Gönder v1-1 <span class="badge bg-light text-dark ms-2">v.1</span></h4>
                    <p class="mb-0 opacity-75 small">Seçili firmalara ödeme detaylarını e-posta ile gönderin</p>
                </div>
                <div>
                    <span class="queue-badge">
                        <i class="fas fa-clock me-1"></i> Kuyruk: <span class="count">@queueCount</span>
                    </span>
                    <a href="/MailGonder/Rapor" class="btn btn-sm btn-light ms-2">
                        <i class="fas fa-chart-bar me-1"></i> Rapor
                    </a>
                </div>
            </div>
        </div>
        <div class="mail-card-body">

            @if (TempData["Hata"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="fas fa-exclamation-triangle me-2"></i> @Html.Raw(TempData["Hata"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Basarili"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="fas fa-check-circle me-2"></i> @Html.Raw(TempData["Basarili"])
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" asp-action="Gonder" id="mailForm">
                @Html.AntiForgeryToken()

                <!-- Talimat Seçimi -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">📄 Talimat Seçin</label>
                        <select name="TalimatId" class="form-select" id="talimatSelect" onchange="this.form.submit()">
                            <option value="">-- Talimat Seçiniz --</option>
                            @foreach (var t in sonTalimatlar)
                            {
                                if (seciliTalimat != null && seciliTalimat.Id == t.Id)
                                {
                                    <option value="@t.Id" selected>@t.TalimatNo - @t.Tarih.ToString("dd.MM.yyyy") (@t.ToplamAdet fatura)</option>
                                }
                                else
                                {
                                    <option value="@t.Id">@t.TalimatNo - @t.Tarih.ToString("dd.MM.yyyy") (@t.ToplamAdet fatura)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="text-muted small">
                            @if (seciliTalimat != null)
                            {
                                <span>📊 <strong>@seciliTalimat.ToplamAdet</strong> fatura, 
                                <strong>@seciliTalimat.ToplamTutar.ToString("N2") TL</strong> toplam</span>
                            }
                        </div>
                    </div>
                </div>

                @if (seciliTalimat != null)
                {
                    <!-- ✅ 1. TALİMAT DETAYLARI -->
                    <div class="talimat-detay mb-4">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detay-item">
                                    <span class="detay-label">📋 Talimat No</span>
                                    <span class="detay-value">@seciliTalimat.TalimatNo</span>
                                </div>
                                <div class="detay-item">
                                    <span class="detay-label">📅 Tarih</span>
                                    <span class="detay-value">@seciliTalimat.Tarih.ToString("dd.MM.yyyy")</span>
                                </div>
                                <div class="detay-item">
                                    <span class="detay-label">🏦 Banka</span>
                                    <span class="detay-value">@seciliTalimat.BankaSubeAdi</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detay-item">
                                    <span class="detay-label">📄 Toplam Fatura</span>
                                    <span class="detay-value">@seciliTalimat.ToplamAdet</span>
                                </div>
                                <div class="detay-item">
                                    <span class="detay-label">💰 Toplam Tutar</span>
                                    <span class="detay-value" style="color:#1e3c72; font-weight:700;">@seciliTalimat.ToplamTutar.ToString("N2") TL</span>
                                </div>
                                <div class="detay-item">
                                    <span class="detay-label">👤 Hazırlayan</span>
                                    <span class="detay-value">@seciliTalimat.HazirlayanKullanici</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="fw-semibold small text-muted">📄 Faturalar</label>
                            <div class="fatura-list">
                                @foreach (var satir in seciliTalimat.Satirlar)
                                {
                                    <div class="fatura-item">
                                        <span class="fatura-no">@satir.Aciklama</span>
                                        <span class="fatura-tutar">@satir.Tutar.ToString("N2") TL</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- ✅ 2. FİRMA LİSTESİ (GRUPLAMALI) -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold mb-0">🏢 Firmalar</label>
                                <div>
                                    <button type="button" class="btn-select-all" onclick="selectAll(true)">Tümünü Seç</button>
                                    <button type="button" class="btn-select-all" onclick="selectAll(false)">Temizle</button>
                                    <button type="button" class="btn-select-all" onclick="selectOnlyWithEmail()">Sadece Email Var</button>
                                </div>
                            </div>

                            <!-- Firmaları gruba göre grupla -->
                            @{
                                var firmaGruplari = firmalar.GroupBy(f => f.Grup ?? "Diğer").OrderBy(g => g.Key);
                            }
                            @foreach (var grup in firmaGruplari)
                            {
                                var grupAdi = grup.Key;
                                var grupFirmaSayisi = grup.Count();
                                var grupEmailVarSayisi = grup.Count(f => !string.IsNullOrEmpty(f.Email));
                                <div class="firma-grup">
                                    <div class="grup-baslik" onclick="toggleGrup(this)">
                                        <span>
                                            <span class="grup-icon">▶</span>
                                            🏢 @grupAdi
                                            <span class="badge bg-light text-dark ms-1">@grupFirmaSayisi firma</span>
                                        </span>
                                        <span>
                                            <span class="badge bg-success">@grupEmailVarSayisi email var</span>
                                            <span class="badge bg-secondary">@(grupFirmaSayisi - grupEmailVarSayisi) email yok</span>
                                        </span>
                                    </div>
                                    <div class="grup-icerik acik">
                                        @foreach (var firma in grup)
                                        {
                                            var hasEmail = !string.IsNullOrEmpty(firma.Email);
                                            var checkedAttr = (preFirmaId.HasValue && firma.Id == preFirmaId.Value) ? "checked" : "";
                                            <div class="firma-item">
                                                <input type="checkbox" name="FirmaIdleri" value="@firma.Id" 
                                                       id="firma_@firma.Id" @(hasEmail ? checkedAttr : "disabled") />
                                                <div class="firma-bilgi">
                                                    <div class="adi">
                                                        @firma.OdemeIsmi
                                                        @if (!hasEmail)
                                                        {
                                                            <span class="badge-email-yok ms-2">📭 Email yok</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge-email-var ms-2">📧 Email var</span>
                                                        }
                                                    </div>
                                                    <div class="email">@(string.IsNullOrEmpty(firma.Email) ? "Email adresi tanımlı değil" : firma.Email)</div>
                                                    <div class="iban">IBAN: @firma.IBAN</div>
                                                </div>
                                                @if (hasEmail)
                                                {
                                                    <label for="firma_@firma.Id" class="text-muted small" style="cursor:pointer;">Seç</label>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="mt-2 text-muted small">
                                <span id="seciliFirmaSayisi">0</span> firma seçildi
                            </div>
                        </div>
                    </div>

                    <!-- ✅ 3. MAİL İÇERİĞİ + ÖNİZLEME -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="row">
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold">📝 Konu</label>
                                    <input type="text" name="Konu" class="form-control" 
                                           value="Ödeme Talimatı - @seciliTalimat.TalimatNo" required />
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">💬 Özel Mesaj</label>
                                    <textarea name="Mesaj" class="form-control" rows="3" 
                                              placeholder="Firmalara göndermek istediğiniz özel mesaj..." 
                                              oninput="yenileOnizleme()"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">👁️ Mail Önizleme</label>
                                    <div class="preview-box" id="previewBox">
                                        <div class="preview-placeholder">
                                            <i class="fas fa-envelope-open-text"></i>
                                            <p>Bir firma seçip önizleme butonuna tıklayın.</p>
                                            <button type="button" class="btn btn-sm btn-primary" onclick="yenileOnizleme()">
                                                <i class="fas fa-sync me-1"></i> Önizleme
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">CC (Karbon Kopya)</label>
                                    <input type="text" name="CC" class="form-control" placeholder="cc@ornek.com" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">BCC (Gizli Karbon Kopya)</label>
                                    <input type="text" name="BCc" class="form-control" placeholder="bcc@ornek.com" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ✅ 4. ZAMANLAMA -->
                    <div class="zamanlama-alani mb-4">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <label class="form-label mb-0">📅 Gönderim Zamanı</label>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex gap-2">
                                    <input type="datetime-local" name="GonderimZamani" class="form-control" id="gonderimZamani" />
                                    <button type="button" class="btn-simdi" onclick="simdiGonder()">Şimdi</button>
                                    <button type="button" class="btn-simdi" onclick="zamanTemizle()">Temizle</button>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted">
                            <i class="fas fa-info-circle me-1"></i> Boş bırakılırsa anında gönderilir. Gelecek bir zaman seçerseniz otomatik gönderim planlanır.
                        </div>
                    </div>

                    <!-- ✅ 5. GÖNDER BUTONU -->
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="/OdemeTalimat" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Geri
                            </a>
                            <button type="button" class="btn btn-outline-primary" onclick="testMail()">
                                <i class="fas fa-paper-plane me-1"></i> Test Maili
                            </button>
                            <button type="button" class="btn btn-outline-success" onclick="yenileOnizleme()">
                                <i class="fas fa-eye me-1"></i> Önizleme
                            </button>
                        </div>
                        <button type="submit" class="btn-mail-gonder" id="gonderBtn" disabled>
                            <i class="fas fa-paper-plane me-2"></i> Mail Gönder
                        </button>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-envelope-open-text fa-3x mb-3 d-block text-secondary"></i>
                        <p>Lütfen yukarıdan bir talimat seçin.</p>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ============================================================
        // 1. FİRMA SEÇİM SAYACI
        // ============================================================
        document.querySelectorAll('input[name="FirmaIdleri"]').forEach(function(cb) {
            cb.addEventListener('change', function() {
                updateSeciliFirmaSayisi();
                updateGonderButonu();
            });
        });

        function updateSeciliFirmaSayisi() {
            var secili = document.querySelectorAll('input[name="FirmaIdleri"]:checked').length;
            document.getElementById('seciliFirmaSayisi').textContent = secili;
        }

        function updateGonderButonu() {
            var secili = document.querySelectorAll('input[name="FirmaIdleri"]:checked').length;
            document.getElementById('gonderBtn').disabled = secili === 0;
        }

        // ============================================================
        // 2. TOPLU SEÇİM
        // ============================================================
        function selectAll(secim) {
            document.querySelectorAll('input[name="FirmaIdleri"]:not(:disabled)').forEach(function(cb) {
                cb.checked = secim;
            });
            updateSeciliFirmaSayisi();
            updateGonderButonu();
        }

        function selectOnlyWithEmail() {
            document.querySelectorAll('input[name="FirmaIdleri"]').forEach(function(cb) {
                if (!cb.disabled) {
                    cb.checked = true;
                } else {
                    cb.checked = false;
                }
            });
            updateSeciliFirmaSayisi();
            updateGonderButonu();
        }

        // ============================================================
        // 3. FİRMA GRUPLAMA (AÇ/KAPA)
        // ============================================================
        function toggleGrup(element) {
            var icerik = element.nextElementSibling;
            var icon = element.querySelector('.grup-icon');
            if (icerik.classList.contains('acik')) {
                icerik.classList.remove('acik');
                icon.textContent = '▶';
            } else {
                icerik.classList.add('acik');
                icon.textContent = '▼';
            }
        }

        // ============================================================
        // 4. ÖNİZLEME
        // ============================================================
        function yenileOnizleme() {
            var firmaId = document.querySelector('input[name="FirmaIdleri"]:checked')?.value;
            var mesaj = document.querySelector('textarea[name="Mesaj"]')?.value || '';
            
            if (!firmaId) {
                document.getElementById('previewBox').innerHTML = `
                    <div class="preview-placeholder">
                        <i class="fas fa-envelope-open-text"></i>
                        <p>Lütfen bir firma seçin.</p>
                    </div>
                `;
                return;
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            
            document.getElementById('previewBox').innerHTML = `
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <p class="text-muted mt-2">Önizleme yükleniyor...</p>
                </div>
            `;

            fetch('/MailGonder/Preview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    talimatId: @(seciliTalimat?.Id ?? 0),
                    firmaId: parseInt(firmaId),
                    ozelMesaj: mesaj
                })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.basarili) {
                    document.getElementById('previewBox').innerHTML = data.html;
                } else {
                    document.getElementById('previewBox').innerHTML = `
                        <div class="alert alert-danger mb-0">
                            <i class="fas fa-exclamation-triangle me-2"></i> ${data.mesaj}
                        </div>
                    `;
                }
            })
            .catch(function() {
                document.getElementById('previewBox').innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> Önizleme yüklenirken hata oluştu.
                    </div>
                `;
            });
        }

        // ============================================================
        // 5. TEST MAİLİ
        // ============================================================
        function testMail() {
            var firmaIdleri = [];
            document.querySelectorAll('input[name="FirmaIdleri"]:checked').forEach(function(cb) {
                firmaIdleri.push(cb.value);
            });
            
            if (firmaIdleri.length === 0) {
                alert('Lütfen en az bir firma seçin.');
                return;
            }
            
            var konu = document.querySelector('input[name="Konu"]').value;
            var mesaj = document.querySelector('textarea[name="Mesaj"]').value;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            document.getElementById('gonderBtn').disabled = true;
            document.getElementById('gonderBtn').innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Gönderiliyor...';

            fetch('/MailGonder/TestGonder', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({
                    firmaIdleri: firmaIdleri,
                    konu: konu,
                    mesaj: mesaj,
                    talimatId: @(seciliTalimat?.Id ?? 0)
                })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('gonderBtn').disabled = false;
                document.getElementById('gonderBtn').innerHTML = '<i class="fas fa-paper-plane me-2"></i> Mail Gönder';
                
                if (data.basarili) {
                    alert('✅ Test maili gönderildi! Lütfen e-posta kutunuzu kontrol edin.');
                } else {
                    alert('❌ Hata: ' + data.mesaj);
                }
            })
            .catch(function() {
                document.getElementById('gonderBtn').disabled = false;
                document.getElementById('gonderBtn').innerHTML = '<i class="fas fa-paper-plane me-2"></i> Mail Gönder';
                alert('❌ Sunucu hatası!');
            });
        }

        // ============================================================
        // 6. ZAMANLAMA
        // ============================================================
        function simdiGonder() {
            var now = new Date();
            now.setMinutes(now.getMinutes() + 2);
            var value = now.toISOString().slice(0, 16);
            document.getElementById('gonderimZamani').value = value;
        }

        function zamanTemizle() {
            document.getElementById('gonderimZamani').value = '';
        }

        // ============================================================
        // 7. SAYFA YÜKLENDİĞİNDE
        // ============================================================
        document.addEventListener('DOMContentLoaded', function() {
            updateSeciliFirmaSayisi();
            updateGonderButonu();
            
            // Tüm grupları varsayılan olarak aç
            document.querySelectorAll('.grup-icerik').forEach(function(el) {
                el.classList.add('acik');
            });
            document.querySelectorAll('.grup-icon').forEach(function(el) {
                el.textContent = '▼';
            });
        });
    </script>
}