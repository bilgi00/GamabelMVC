@{
    ViewData["Title"] = "Hızlı Mesai Girişi";
      Layout = "_Layout";
    // TÜM değişkenleri burada tanımla
    var birimler = (ViewBag.Birimler as List<string>) ?? new List<string>();
    var personelStatuleri = (ViewBag.PersonelStatuleri as List<string>) ?? new List<string>();
    var personeller = (ViewBag.Personeller as List<dynamic>) ?? new List<dynamic>();
    var personelMesaiVerileri = (ViewBag.PersonelMesaiVerileri as Dictionary<string, Dictionary<string, dynamic>>) ?? new Dictionary<string, Dictionary<string, dynamic>>();
    var secilenYil = (int?)ViewBag.SecilenYil ?? DateTime.Now.Year;
    var secilenAy = (int?)ViewBag.SecilenAy ?? DateTime.Now.Month;
    var secilenBirim = (string?)ViewBag.SecilenBirim ?? "";
    var secilenStatu = (string?)ViewBag.SecilenStatu ?? "__TUMU__";
    var gunSayisi = (int?)ViewBag.GunSayisi ?? DateTime.DaysInMonth(secilenYil, secilenAy);
    var rol = ViewBag.Rol ?? "";
    var kullaniciBirim = ViewBag.KullaniciBirim ?? "";
    var isAdmin = ViewBag.Rol == "admin";
    
    // Ay adlarını tanımla
    var ayAdlari = new[] { "", "Ocak", "Şubat", "Mart", "Nisan", "Mayıs", "Haziran", 
                           "Temmuz", "Ağustos", "Eylül", "Ekim", "Kasım", "Aralık" };
    
    // Hafta sonu sayısını hesapla
    int haftaSonuSayisi = 0;
    for (int gun = 1; gun <= gunSayisi; gun++)
    {
        var tarih = new DateTime(secilenYil, secilenAy, gun);
        if (tarih.DayOfWeek == DayOfWeek.Saturday || tarih.DayOfWeek == DayOfWeek.Sunday)
        {
            haftaSonuSayisi++;
        }
    }
}

@functions {
    // Decimal saat değerini "Saat:Dakika" formatına dönüştür
    private string FormatSaatDakika(object saatDegeri)
    {
        if (saatDegeri == null) return "0:00";
        
        decimal saat = 0;
        try
        {
            if (saatDegeri is string strDeger)
            {
                strDeger = strDeger.Trim();
                
                if (strDeger.Contains(":"))
                {
                    var parts = strDeger.Split(':');
                    if (parts.Length == 2 && int.TryParse(parts[0], out var saatInt2) && int.TryParse(parts[1], out var dakika2))
                    {
                        if (dakika2 >= 60)
                        {
                            saatInt2 += dakika2 / 60;
                            dakika2 %= 60;
                        }
                        return $"{saatInt2}:{dakika2:D2}";
                    }
                }

                strDeger = strDeger.Replace(',', '.');
                if (!decimal.TryParse(strDeger, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out saat))
                {
                    decimal.TryParse(strDeger, System.Globalization.NumberStyles.Any, new System.Globalization.CultureInfo("tr-TR"), out saat);
                }
            }
            else
            {
                saat = Convert.ToDecimal(saatDegeri);
            }
        }
        catch
        {
            return "0:00";
        }
        
        int saatInt = (int)Math.Floor(saat);
        int dakika = (int)Math.Round((saat - saatInt) * 60);
        
        if (dakika >= 60)
        {
            saatInt++;
            dakika = 0;
        }
        
        return $"{saatInt}:{dakika:D2}";
    }
    
    // Saat string'ini decimal'e çevir
    private decimal SaatToDecimal(string saatStr)
    {
        if (string.IsNullOrEmpty(saatStr)) return 0;
        
        var parts = saatStr.Split(':');
        if (parts.Length == 2)
        {
            int saat = int.Parse(parts[0]);
            int dakika = int.Parse(parts[1]);
            return saat + (dakika / 60m);
        }
        return 0;
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hızlı Mesai Girişi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="hizli-mesai-page">

    <div class="container-fluid px-0">

        <!-- MAIN CARD -->
        <div class="dashboard-card">

            <!-- HEADER -->
            <div class="row align-items-center g-2 mb-2">
                <div class="col-md-6">
                    <div class="page-headline">
                        <i class="bi bi-lightning-charge-fill text-primary me-2"></i> Hızlı Mesai Girişi
                    </div>
                    <div class="page-sub">Personel mesai saatlerini hızlıca giriniz.</div>
                </div>
                <div class="col-md-6">
                    <div class="btn-group-icon no-print">
                        <button class="btn btn-batch" onclick="acBatchModal()">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Toplu Giriş
                        </button>
                        <button class="btn btn-success btn-soft-primary" onclick="takvimKaydet()"><i class="bi bi-check-lg me-1"></i> Kaydet</button>
                        <button class="btn btn-soft-primary" onclick="takvimExcelAktar()"><i class="bi bi-file-earmark-excel me-1"></i> Excel</button>
                        <button class="btn btn-soft-primary" onclick="takvimPdfIndir()"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</button>
                        <button class="btn btn-soft-primary" onclick="takvimYazdir()"><i class="bi bi-printer me-1"></i> Yazdır</button>
                        <button class="btn btn-soft-primary" onclick="acReportModal()"><i class="bi bi-bar-chart-fill me-1"></i> Rapor</button>
                    </div>
                </div>
            </div>

            <!-- FILTER ROW -->
            <div class="row g-2 align-items-end mb-2">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary" style="font-size:13px;">Birim</label>
                    <select id="subeSelect" class="form-select form-select-sm rounded-3 border-0 bg-light" style="font-size:13px; padding:6px 12px;" onchange="birimSecildi()">
                        <option value="">-- Birim Seçiniz --</option>
                        @foreach (var birim in birimler)
                        {
                            if (birim == secilenBirim)
                            {
                                <option value="@birim" selected>@birim</option>
                            }
                            else
                            {
                                <option value="@birim">@birim</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary" style="font-size:13px;">Personel Statüsü</label>
                    <select id="statuSelect" class="form-select form-select-sm rounded-3 border-0 bg-light" style="font-size:13px; padding:6px 12px;" onchange="statuSecildi()">
                        @if (secilenStatu == "__TUMU__")
                        {
                            <option value="__TUMU__" selected>-- Tüm Personeller --</option>
                        }
                        else
                        {
                            <option value="__TUMU__">-- Tüm Personeller --</option>
                        }
                        @foreach (var statu in personelStatuleri)
                        {
                            if (statu == secilenStatu)
                            {
                                <option value="@statu" selected>@statu</option>
                            }
                            else
                            {
                                <option value="@statu">@statu</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary" for="personelArama" style="font-size:13px;">Personel Ara</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                        <input id="personelArama" type="search" class="form-control border-0 bg-light" placeholder="Ad veya soyad yazın..." autocomplete="off" oninput="personelAra(this.value)" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary" style="font-size:13px;">Ay &amp; Yıl</label>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-primary rounded-3 px-3 no-print" style="font-size:13px; padding:4px 12px;" onclick="ayDegistir(-1)">←</button>
                        <span class="month-badge" id="monthTitle">@ayAdlari[secilenAy] @secilenYil</span>
                        <button class="btn btn-outline-primary rounded-3 px-3 no-print" style="font-size:13px; padding:4px 12px;" onclick="ayDegistir(1)">→</button>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <div id="takvimActionMsg" class="text-muted small fst-italic" style="font-size:12px;"></div>
                </div>
            </div>

            <!-- INFO ALERT -->
            <div class="alert alert-info-custom d-flex align-items-center gap-3 no-print" style="padding:8px 16px; font-size:13px;">
                <i class="bi bi-info-circle-fill fs-5 text-primary"></i>
                <div>
                    <strong>Tıklayarak mesai girebilirsiniz.</strong> Sağ tık veya Shift+Click ile silebilirsiniz.
                    Hafta sonları <span class="badge bg-danger bg-opacity-10 text-danger">kırmızı</span> renkle gösterilir.
                </div>
            </div>

            <!-- CALENDAR TABLE -->
            @if (!string.IsNullOrEmpty(secilenBirim) && personeller.Count > 0)
            {
                <div class="table-shell">
                    <div class="table-wrap">
                        <table class="mesai-table" id="mesaiTable">
                        <thead>
                            <tr>
                                <th class="sticky-personel" style="min-width:130px; font-size:11px;">
                                    <i class="bi bi-people-fill"></i> PERSONEL
                                </th>
                                @for (int gun = 1; gun <= gunSayisi; gun++)
                                {
                                    var tarih = new DateTime(secilenYil, secilenAy, gun);
                                    var isWeekend = tarih.DayOfWeek == DayOfWeek.Saturday || tarih.DayOfWeek == DayOfWeek.Sunday;
                                    var haftaSinif = isWeekend ? (tarih.DayOfWeek == DayOfWeek.Saturday ? "weekend-sat-col" : "weekend-sun-col") : "";
                                    var bugunMu = tarih.Date == DateTime.Now.Date;
                                    <th class="@haftaSinif @(bugunMu ? "cell-today" : "")" style="min-width:38px; font-size:11px; padding:4px 2px;">
                                        <span class="day-num" style="font-size:13px;">@gun</span>
                                        <span class="day-name" style="font-size:8px;">@tarih.ToString("ddd", new System.Globalization.CultureInfo("tr-TR")).ToUpper()</span>
                                    </th>
                                }
                                <th class="bg-light toplam-baslik">TOPLAM</th>
                                <th class="bg-light toplam-detay-baslik">+ Hafta Sonu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var personel in personeller)
                            {
                                <tr data-personel-adi="@personel.AdSoyad">
                                    <td class="sticky-personel" style="font-size:11px; padding:3px 8px;">
                                        <i class="bi bi-person-circle" style="font-size:13px;"></i> @personel.AdSoyad
                                    </td>
                                    @for (int gun = 1; gun <= gunSayisi; gun++)
                                    {
                                        var tarih = new DateTime(secilenYil, secilenAy, gun);
                                        var isWeekend = tarih.DayOfWeek == DayOfWeek.Saturday || tarih.DayOfWeek == DayOfWeek.Sunday;
                                        var haftaSinif = isWeekend ? (tarih.DayOfWeek == DayOfWeek.Saturday ? "weekend-sat-col" : "weekend-sun-col") : "";
                                        var bugunMu = tarih.Date == DateTime.Now.Date;

                                        if (personelMesaiVerileri.ContainsKey(personel.PerNo) &&
                                            personelMesaiVerileri[personel.PerNo].ContainsKey(gun.ToString()))
                                        {
                                            var mesai = personelMesaiVerileri[personel.PerNo][gun.ToString()];
                                            var saatStr = FormatSaatDakika(mesai.ToplamSaat);
                                            <td class="@haftaSinif @(bugunMu ? "cell-today" : "")" data-gun="@gun" data-saat="@mesai.ToplamSaat.ToString(System.Globalization.CultureInfo.InvariantCulture)" style="padding:1px;">
                                                <div class="mesai-cell" onclick="mesaiDetay('@personel.PerNo', @gun, @mesai.Id)" oncontextmenu="silMesai(event, '@personel.PerNo', @gun, @mesai.Id)" title="Tıkla düzenle, Sağ tık sil" data-bs-toggle="tooltip" style="min-height:30px; font-size:11px;">
                                                    <span class="badge-pill" style="font-size:10px; padding:2px 8px;">@saatStr</span>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="@haftaSinif @(bugunMu ? "cell-today" : "")" data-gun="@gun" data-saat="0" style="padding:1px;">
                                                <div class="mesai-cell" onclick="yeniMesaiEkle('@personel.PerNo', @gun)" title="Mesai Gir" data-bs-toggle="tooltip" style="min-height:30px;">
                                                    <span class="empty-plus" style="font-size:16px;">+</span>
                                                </div>
                                            </td>
                                        }
                                    }
                                    <td class="personel-toplam" data-personel-id="@personel.PerNo" style="font-size:11px; padding:3px 4px;">
                                        <span id="toplam-@personel.PerNo">00:00</span>
                                    </td>
                                    <td class="personel-toplam-detay" data-personel-id="@personel.PerNo" style="font-size:10px; padding:3px 4px;">
                                        <span id="toplamDetay-@personel.PerNo">
                                            <span class="normal-saat">00:00</span><br/>
                                            <span class="ekstra-saat">+0</span><br/>
                                            <span class="toplam-saat">00:00</span>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        </table>
                    </div>
                </div>

                <!-- STATS CARDS -->
                <div class="row g-2 mt-3">
                    <div class="col-6 col-md-3">
                        <div class="stats-mini-card" style="padding:10px 8px;">
                            <div><span class="stat-icon" style="font-size:16px;">📅</span><span class="stat-label" style="font-size:11px;">Toplam Gün</span></div>
                            <div class="stat-number" style="font-size:20px;">@gunSayisi</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stats-mini-card" style="padding:10px 8px;">
                            <div><span class="stat-icon" style="font-size:16px;">👤</span><span class="stat-label" style="font-size:11px;">Personel</span></div>
                            <div class="stat-number" style="font-size:20px;">@personeller.Count</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stats-mini-card" style="padding:10px 8px;">
                            <div><span class="stat-icon" style="font-size:16px;">📆</span><span class="stat-label" style="font-size:11px;">Hafta Sonu</span></div>
                            <div class="stat-number" style="font-size:20px;">@haftaSonuSayisi</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="stats-mini-card" style="padding:10px 8px;">
                            <div><span class="stat-icon" style="font-size:16px;">⏱</span><span class="stat-label" style="font-size:11px;">Girilen Mesai</span></div>
                            <div class="stat-number" id="toplamMesaiSaat" style="font-size:20px;">0</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <p class="fw-semibold" style="font-size:14px;">@(string.IsNullOrEmpty(secilenBirim) ? "Lütfen birim seçiniz." : "Seçilen birimde aktif personel bulunmamaktadır.")</p>
                </div>
            }

        </div><!-- /.dashboard-card -->
    </div><!-- /.container-fluid -->

    <!-- TEKİL MESAI MODAL -->
    <div class="modal fade modal-custom" id="mesaiModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius:20px; padding:6px 2px;">
                <div class="modal-header" style="padding:12px 16px 0 16px;">
                    <h5 class="modal-title" id="mesaiModalTitle" style="font-size:17px;">Mesai Girişi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding:16px;">
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:13px;"><i class="bi bi-calendar3 me-2"></i>Tarih</label>
                        <input id="mesaiTarih" type="text" class="form-control" readonly style="font-size:13px; padding:8px 16px;" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-semibold" style="font-size:13px;"><i class="bi bi-clock me-2"></i>Başlangıç</label>
                            <input id="mesaiBaslangic" type="time" class="form-control" style="font-size:13px; padding:8px 16px;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold" style="font-size:13px;"><i class="bi bi-clock me-2"></i>Bitiş</label>
                            <input id="mesaiBitis" type="time" class="form-control" style="font-size:13px; padding:8px 16px;" />
                        </div>
                    </div>
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <div id="mesaiSureBilgi" class="text-muted small" style="font-size:12px;">Süre: —</div>
                        </div>
                        <div class="col-6 text-end">
                            <div id="mesaiAylikUyari" class="text-danger small" style="font-size:11px; display:none;"></div>
                        </div>
                    </div>
                    <div class="mb-2 mt-2">
                        <label class="form-label fw-semibold" style="font-size:13px;"><i class="bi bi-pencil me-2"></i>Açıklama</label>
                        <textarea id="mesaiAciklama" rows="2" class="form-control" placeholder="Opsiyonel not" style="font-size:13px; padding:8px 12px;"></textarea>
                    </div>
                    <div id="mesaiModalMsg" class="text-danger small mt-1" style="font-size:12px;"></div>
                </div>
                <div class="modal-footer border-0" style="padding:0 16px 16px 16px;">
                    <button type="button" class="btn btn-danger btn-sm" id="btnSilMesai" onclick="silMesaiKaydi()" style="display:none; border-radius:40px; padding:6px 16px;">
                        <i class="bi bi-trash me-1"></i> Sil
                    </button>
                    <button type="button" class="btn-soft-cancel" data-bs-dismiss="modal" style="font-size:13px; padding:6px 20px;">Vazgeç</button>
                    <button type="button" class="btn-primary-custom" onclick="kaydetMesai()" style="font-size:13px; padding:6px 20px;">Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- TOPLU MESAI GİRİŞİ MODAL -->
    <div class="modal fade modal-custom" id="batchModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="border-radius:20px; padding:6px 2px;">
                <div class="modal-header" style="padding:16px 20px 0 20px;">
                    <h5 class="modal-title" style="font-size:18px;">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i>Toplu Mesai Girişi
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding:20px;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:14px;">Personel Seçiniz</label>
                        <select id="batchPersonel" class="form-select" style="font-size:14px; padding:8px 12px; border-radius:12px;">
                            <option value="">-- Personel Seçiniz --</option>
                            @foreach (var personel in personeller)
                            {
                                <option value="@personel.PerNo" data-personel-adi="@personel.AdSoyad">@personel.AdSoyad</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="font-size:14px;">Gün Seçiniz</label>
                        <div id="batchDaysContainer" style="max-height:300px; overflow-y:auto; border:1px solid #E2E8F0; border-radius:12px; padding:10px;">
                            @for (int gun = 1; gun <= gunSayisi; gun++)
                            {
                                var tarih = new DateTime(secilenYil, secilenAy, gun);
                                var isWeekend = tarih.DayOfWeek == DayOfWeek.Saturday || tarih.DayOfWeek == DayOfWeek.Sunday;
                                var gunAdi = tarih.ToString("ddd", new System.Globalization.CultureInfo("tr-TR"));
                                <div class="batch-day-item" style="padding:6px 10px; border:1px solid #E2E8F0; border-radius:8px; margin-bottom:6px; display:flex; align-items:center; gap:10px; font-size:13px; @(isWeekend ? "background:#FDE2E4;" : "")">
                                    <input type="checkbox" class="batch-day-check" value="@gun" />
                                    <div class="day-info" style="flex:1;">
                                        <strong>@gun</strong> - @gunAdi
                                        @if (isWeekend)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size:10px;">Hafta Sonu</span>
                                        }
                                    </div>
                                    <div class="time-inputs" style="display:flex; gap:8px; align-items:center;">
                                        <input type="time" class="batch-start" value="08:00" style="width:100px; padding:4px 8px; border:1px solid #E2E8F0; border-radius:6px; font-size:12px;" />
                                        <span style="font-size:12px; color:#94A3B8;">-</span>
                                        <input type="time" class="batch-end" value="13:00" style="width:100px; padding:4px 8px; border:1px solid #E2E8F0; border-radius:6px; font-size:12px;" />
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold" style="font-size:14px;"><i class="bi bi-pencil me-2"></i>Açıklama (Ortak)</label>
                        <input id="batchAciklama" type="text" class="form-control" placeholder="Tüm kayıtlar için ortak açıklama" style="font-size:13px; padding:8px 12px; border-radius:12px;" />
                    </div>
                    <div id="batchModalMsg" class="text-danger small mt-1" style="font-size:12px;"></div>
                </div>
                <div class="modal-footer border-0" style="padding:0 20px 20px 20px;">
                    <button type="button" class="btn-soft-cancel" data-bs-dismiss="modal" style="font-size:13px; padding:6px 20px;">Vazgeç</button>
                    <button type="button" class="btn-primary-custom" onclick="kaydetTopluMesai()" style="font-size:13px; padding:6px 20px;">
                        <i class="bi bi-check-lg me-1"></i>Tümünü Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MESAI RAPOR MODAL -->
    <div class="modal fade modal-custom" id="reportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content" style="border-radius:20px; padding:6px 2px;">
                <div class="modal-header" style="padding:16px 20px 0 20px;">
                    <h5 class="modal-title" style="font-size:18px;">
                        <i class="bi bi-bar-chart-fill me-2"></i>Mesai Raporu
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding:20px;">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="stats-mini-card" style="padding:16px;">
                                <div><span class="stat-icon">👤</span><span class="stat-label">En Çok Mesai Yapan</span></div>
                                <div class="stat-number" id="reportTopPersonel" style="font-size:18px;">-</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-mini-card" style="padding:16px;">
                                <div><span class="stat-icon">📊</span><span class="stat-label">Aylık Toplam Mesai</span></div>
                                <div class="stat-number" id="reportToplamMesai" style="font-size:18px;">-</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stats-mini-card" style="padding:16px;">
                                <div><span class="stat-icon">📈</span><span class="stat-label">Ortalama Günlük Mesai</span></div>
                                <div class="stat-number" id="reportOrtalama" style="font-size:18px;">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3" style="max-height:400px; overflow-y:auto;">
                        <table class="table table-bordered table-striped" style="font-size:13px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Personel</th>
                                    <th>Toplam Mesai</th>
                                    <th>Günlük Ortalama</th>
                                    <th>Gün Sayısı</th>
                                </tr>
                            </thead>
                            <tbody id="reportTableBody">
                                <tr>
                                    <td colspan="4" class="text-center text-muted">Veri bulunmuyor</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0" style="padding:0 20px 20px 20px;">
                    <button type="button" class="btn-soft-cancel" data-bs-dismiss="modal" style="font-size:13px; padding:6px 20px;">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        // ----- GLOBAL STATE -----
        let seciliHucre = { personelId: 0, gun: 0, mode: 'new' };
        let seciliKayitId = 0;
        let modalInstance = null;
        let batchModalInstance = null;
        let reportModalInstance = null;
        let silModu = false;

        document.addEventListener('DOMContentLoaded', function() {
            // Bootstrap modal init
            const modalEl = document.getElementById('mesaiModal');
            modalInstance = new bootstrap.Modal(modalEl);
            
            const batchModalEl = document.getElementById('batchModal');
            batchModalInstance = new bootstrap.Modal(batchModalEl);
            
            const reportModalEl = document.getElementById('reportModal');
            reportModalInstance = new bootstrap.Modal(reportModalEl);

            document.getElementById('mesaiBaslangic').addEventListener('input', hesaplaSure);
            document.getElementById('mesaiBitis').addEventListener('input', hesaplaSure);
            document.getElementById('mesaiBaslangic').addEventListener('change', hesaplaSure);
            document.getElementById('mesaiBitis').addEventListener('change', hesaplaSure);

            // Modal açıldığında verileri yükle
            modalEl.addEventListener('show.bs.modal', function() {
                if (seciliHucre.mode === 'new') hesaplaSure();
            });

            hesaplaToplamlar();
            istatistikleriGuncelle();
            hesaplaDetayliToplamlar();
            kontrol88SaatUyarisi();

            // tooltipleri aktif et
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(el => new bootstrap.Tooltip(el));

            sabitTabloBasliginiOlustur();
        });

        function personelAra(aramaMetni) {
            const arama = (aramaMetni || '').trim().toLocaleLowerCase('tr-TR');

            document.querySelectorAll('#mesaiTable tbody tr').forEach(row => {
                const personelAdi = (row.dataset.personelAdi || '').toLocaleLowerCase('tr-TR');
                row.hidden = arama !== '' && !personelAdi.includes(arama);
            });

            document.querySelectorAll('#batchPersonel option[data-personel-adi]').forEach(option => {
                const personelAdi = (option.dataset.personelAdi || '').toLocaleLowerCase('tr-TR');
                option.hidden = arama !== '' && !personelAdi.includes(arama);
            });
        }

        function sabitTabloBasliginiOlustur() {
            const tableWrap = document.querySelector('.table-wrap');
            const table = document.getElementById('mesaiTable');
            if (!tableWrap || !table || !table.tHead) return;

            const stickyHeader = document.createElement('div');
            stickyHeader.className = 'sticky-table-header';

            const stickyTable = table.cloneNode(true);
            stickyTable.removeAttribute('id');
            const stickyBody = stickyTable.querySelector('tbody');
            if (stickyBody) stickyBody.remove();
            stickyTable.style.width = table.offsetWidth + 'px';
            stickyTable.style.minWidth = table.offsetWidth + 'px';

            const originalCells = table.tHead.rows[0].cells;
            const stickyCells = stickyTable.tHead.rows[0].cells;
            for (let index = 0; index < originalCells.length; index++) {
                const width = originalCells[index].getBoundingClientRect().width;
                if (stickyCells[index]) {
                    stickyCells[index].style.width = width + 'px';
                    stickyCells[index].style.minWidth = width + 'px';
                    stickyCells[index].style.maxWidth = width + 'px';
                }
            }

            stickyHeader.appendChild(stickyTable);
            tableWrap.parentElement.appendChild(stickyHeader);
            table.tHead.style.visibility = 'hidden';

            const syncStickyHeader = function() {
                stickyTable.style.transform = 'translateX(-' + tableWrap.scrollLeft + 'px)';
            };

            tableWrap.addEventListener('scroll', syncStickyHeader, { passive: true });
            window.addEventListener('resize', function() {
                stickyTable.style.width = table.offsetWidth + 'px';
                stickyTable.style.minWidth = table.offsetWidth + 'px';
                syncStickyHeader();
            });
            syncStickyHeader();
        }

        // ----- MESAI VERİLERİNİ GETİR (Düzenleme için) -----
        async function mesaiVerileriniGetir(kayitId) {
            try {
                const response = await fetch('/HizliMesaiGirisi/GetMesaiDetay?kayitId=' + kayitId);
                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('mesaiBaslangic').value = data.baslangic || '';
                    document.getElementById('mesaiBitis').value = data.bitis || '';
                    document.getElementById('mesaiAciklama').value = data.aciklama || '';
                    // Sil butonunu göster
                    document.getElementById('btnSilMesai').style.display = 'inline-block';
                    hesaplaSure();
                }
            } catch (err) {
                console.error('Veri getirme hatası:', err);
            }
        }

        // ----- TOPLAM HESAPLAMA (saat toplamları) -----
        function hesaplaToplamlar() {
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                let toplamDakika = 0;
                const cells = row.querySelectorAll('td[data-saat]');
                cells.forEach(cell => {
                    const val = parseFloat(cell.getAttribute('data-saat')) || 0;
                    toplamDakika += Math.round(val * 60);
                });
                const toplamCell = row.querySelector('.personel-toplam span');
                if (toplamCell) {
                    toplamCell.textContent = formatDakika(toplamDakika);
                }
            });
        }

        // ----- DETAYLI TOPLAM HESAPLAMA (Normal + Hafta Sonu) -----
        function hesaplaDetayliToplamlar() {
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                let normalToplamDakika = 0;
                let haftaSonuToplamDakika = 0;
                let toplamDakika = 0;
                const cells = row.querySelectorAll('td[data-saat]');
                cells.forEach(cell => {
                    const val = parseFloat(cell.getAttribute('data-saat')) || 0;
                    const dakika = Math.round(val * 60);
                    const gun = parseInt(cell.getAttribute('data-gun'));
                    toplamDakika += dakika;
                    
                    // Hafta sonu kontrolü
                    const tarih = new Date(@secilenYil, @secilenAy - 1, gun);
                    const isWeekend = tarih.getDay() === 0 || tarih.getDay() === 6;
                    if (isWeekend) {
                        haftaSonuToplamDakika += dakika;
                    } else {
                        normalToplamDakika += dakika;
                    }
                });
                
                const detayCell = row.querySelector('.personel-toplam-detay');
                if (detayCell) {
                    const normalSpan = detayCell.querySelector('.normal-saat');
                    const ekstraSpan = detayCell.querySelector('.ekstra-saat');
                    const toplamSpan = detayCell.querySelector('.toplam-saat');
                    
                    if (normalSpan) normalSpan.textContent = formatDakika(normalToplamDakika);
                    if (ekstraSpan) ekstraSpan.textContent = '+' + formatDakika(haftaSonuToplamDakika);
                    if (toplamSpan) toplamSpan.textContent = formatDakika(toplamDakika);
                }
            });
        }

        function formatDakika(toplamDakika) {
            const dakika = Math.max(0, Math.round(Number(toplamDakika) || 0));
            return Math.floor(dakika / 60) + ':' + String(dakika % 60).padStart(2, '0');
        }

        function formatSaatDakika(saat) {
            if (saat === null || saat === undefined || saat === '') {
                return '0:00';
            }

            if (typeof saat === 'string') {
                const raw = saat.trim();
                if (raw.includes(':')) {
                    const parts = raw.split(':');
                    if (parts.length === 2) {
                        let h = parseInt(parts[0], 10) || 0;
                        let m = parseInt(parts[1], 10) || 0;
                        if (m >= 60) {
                            h += Math.floor(m / 60);
                            m = m % 60;
                        }
                        return h + ':' + String(m).padStart(2, '0');
                    }
                }
                saat = parseFloat(raw.replace(',', '.'));
            }

            const num = Number(saat);
            if (Number.isNaN(num)) {
                return '0:00';
            }

            const s = Math.floor(num);
            let d = Math.round((num - s) * 60);
            if (d >= 60) {
                d = 0;
            }
            return s + ':' + String(d).padStart(2, '0');
        }

        // ----- İSTATİSTİK KARTLARI -----
        function istatistikleriGuncelle() {
            let toplamSaat = 0;
            document.querySelectorAll('.personel-toplam span').forEach(el => {
                const txt = el.textContent.trim();
                const parts = txt.split(':');
                if (parts.length === 2) {
                    const s = parseInt(parts[0]) || 0;
                    const d = parseInt(parts[1]) || 0;
                    toplamSaat += s + (d / 60);
                }
            });
            const toplamSaatEl = document.getElementById('toplamMesaiSaat');
            if (toplamSaatEl) {
                toplamSaatEl.textContent = Math.round(toplamSaat) + ' Saat';
            }
        }

        // ----- 88 SAAT UYARISI -----
        function kontrol88SaatUyarisi() {
            document.querySelectorAll('.personel-toplam').forEach(el => {
                const span = el.querySelector('span');
                if (!span) return;
                const txt = span.textContent.trim();
                const parts = txt.split(':');
                let toplam = 0;
                if (parts.length === 2) {
                    toplam = parseInt(parts[0]) || 0;
                }
                if (toplam > 88) {
                    el.classList.add('uyari-aylik');
                    el.title = 'Aylık 88 saat kotası aşıldı!';
                } else {
                    el.classList.remove('uyari-aylik');
                    el.title = '';
                }
            });
        }

        // ----- SAAT HESAPLAMA (Canlı) -----
        function hesaplaSure() {
            const baslangic = document.getElementById('mesaiBaslangic').value;
            const bitis = document.getElementById('mesaiBitis').value;
            const bilgiEl = document.getElementById('mesaiSureBilgi');
            const uyariEl = document.getElementById('mesaiAylikUyari');
            
            if (!baslangic || !bitis) {
                bilgiEl.textContent = 'Süre: —';
                return null;
            }

            const basParts = baslangic.split(':');
            const bitParts = bitis.split(':');
            
            if (basParts.length !== 2 || bitParts.length !== 2) {
                bilgiEl.textContent = 'Süre: Geçersiz format';
                return null;
            }

            const basSaat = parseInt(basParts[0]);
            const basDak = parseInt(basParts[1]);
            const bitSaat = parseInt(bitParts[0]);
            const bitDak = parseInt(bitParts[1]);

            const basToplamDak = basSaat * 60 + basDak;
            const bitToplamDak = bitSaat * 60 + bitDak;
            let farkDk = bitToplamDak - basToplamDak;

            if (farkDk <= 0) {
                bilgiEl.textContent = 'Bitiş saati başlangıçtan sonra olmalıdır!';
                bilgiEl.style.color = '#DC2626';
                return null;
            }

            // 8 saat kontrolü
            if (farkDk > 480) {
                bilgiEl.textContent = '⚠️ 8 saatten fazla mesai girilemez!';
                bilgiEl.style.color = '#DC2626';
                return null;
            }

            bilgiEl.style.color = '#475569';
            const saat = Math.floor(farkDk / 60);
            const dakika = farkDk % 60;
            bilgiEl.textContent = 'Süre: ' + saat + ' saat ' + dakika + ' dk';

            // Aylık 88 saat kontrolü
            if (seciliHucre.personelId) {
                const toplamSpan = document.querySelector('.personel-toplam[data-personel-id="' + seciliHucre.personelId + '"] span');
                if (toplamSpan) {
                    const txt = toplamSpan.textContent.trim();
                    const parts = txt.split(':');
                    let mevcutToplam = 0;
                    if (parts.length === 2) {
                        mevcutToplam = parseInt(parts[0]) || 0;
                    }
                    const yeniToplam = mevcutToplam + (farkDk / 60);
                    if (yeniToplam > 88) {
                        uyariEl.style.display = 'block';
                        uyariEl.textContent = '⚠️ Bu kayıt ile aylık 88 saat aşılıyor! (Mevcut: ' + formatSaatDakika(mevcutToplam) + ')';
                    } else {
                        uyariEl.style.display = 'none';
                    }
                }
            }

            return farkDk;
        }

        // ----- NAVIGATION -----
        function birimSecildi() {
            const birim = document.getElementById('subeSelect').value;
            if (birim) {
                const statu = document.getElementById('statuSelect')?.value || '__TUMU__';
                window.location.href = `/HizliMesaiGirisi/Index?birim=${encodeURIComponent(birim)}&statu=${encodeURIComponent(statu)}&yil=@secilenYil&ay=@secilenAy`;
            }
        }

        function statuSecildi() {
            const birim = document.getElementById('subeSelect').value;
            const statu = document.getElementById('statuSelect').value;
            if (birim) {
                window.location.href = `/HizliMesaiGirisi/Index?birim=${encodeURIComponent(birim)}&statu=${encodeURIComponent(statu)}&yil=@secilenYil&ay=@secilenAy`;
            }
        }

        function ayDegistir(miktar) {
            let ay = @secilenAy + miktar;
            let yil = @secilenYil;
            if (ay > 12) { ay = 1; yil++; }
            else if (ay < 1) { ay = 12; yil--; }
            const birim = document.getElementById('subeSelect').value;
            if (birim) {
                const statu = document.getElementById('statuSelect')?.value || '__TUMU__';
                window.location.href = `/HizliMesaiGirisi/Index?birim=${encodeURIComponent(birim)}&statu=${encodeURIComponent(statu)}&yil=${yil}&ay=${ay}`;
            }
        }

        // ----- TEKİL MODAL OPERATIONS -----
        function yeniMesaiEkle(personelId, gun) {
            seciliHucre = { personelId, gun, mode: 'new' };
            seciliKayitId = 0;
            const tarih = `${@secilenYil}-${String(@secilenAy).padStart(2, '0')}-${String(gun).padStart(2, '0')}`;
            document.getElementById('mesaiTarih').value = tarih;
            document.getElementById('mesaiModalTitle').textContent = 'Mesai Girişi';
            document.getElementById('mesaiModalMsg').textContent = '';
            document.getElementById('mesaiBaslangic').value = '08:00';
            document.getElementById('mesaiBitis').value = '13:00';
            document.getElementById('mesaiAciklama').value = '';
            document.getElementById('mesaiSureBilgi').textContent = 'Süre: —';
            document.getElementById('mesaiSureBilgi').style.color = '#475569';
            document.getElementById('mesaiAylikUyari').style.display = 'none';
            document.getElementById('btnSilMesai').style.display = 'none';
            hesaplaSure();
            modalInstance.show();
        }

        function mesaiDetay(personelId, gun, kayitId) {
            seciliHucre = { personelId, gun, mode: 'edit' };
            seciliKayitId = kayitId || 0;
            const tarih = `${@secilenYil}-${String(@secilenAy).padStart(2, '0')}-${String(gun).padStart(2, '0')}`;
            document.getElementById('mesaiTarih').value = tarih;
            document.getElementById('mesaiModalTitle').textContent = 'Mesai Güncelle';
            document.getElementById('mesaiModalMsg').textContent = '';
            document.getElementById('mesaiAciklama').value = '';
            document.getElementById('btnSilMesai').style.display = 'inline-block';
            document.getElementById('mesaiSureBilgi').textContent = 'Süre: —';
            document.getElementById('mesaiSureBilgi').style.color = '#475569';
            document.getElementById('mesaiAylikUyari').style.display = 'none';
            
            // Verileri getir
            mesaiVerileriniGetir(kayitId);
            
            modalInstance.show();
        }

        // ----- MESAI SİLME (Sağ Tık ile) -----
        function silMesai(event, personelId, gun, kayitId) {
            event.preventDefault();
            if (confirm('Bu mesai kaydını silmek istediğinizden emin misiniz?')) {
                fetch('/HizliMesaiGirisi/Sil', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(kayitId)
                })
                .then(function(response) {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Silme işlemi başarısız oldu.');
                    }
                })
                .catch(function() {
                    alert('Sunucu hatası!');
                });
            }
        }

        // ----- SİL BUTONU (Modal içinden) -----
        function silMesaiKaydi() {
            if (seciliKayitId > 0) {
                if (confirm('Bu mesai kaydını silmek istediğinizden emin misiniz?')) {
                    fetch('/HizliMesaiGirisi/Sil', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(seciliKayitId)
                    })
                    .then(function(response) {
                        if (response.ok) {
                            modalInstance.hide();
                            window.location.reload();
                        } else {
                            document.getElementById('mesaiModalMsg').textContent = 'Silme işlemi başarısız oldu.';
                            document.getElementById('mesaiModalMsg').style.color = '#DC2626';
                        }
                    })
                    .catch(function() {
                        document.getElementById('mesaiModalMsg').textContent = 'Sunucu hatası!';
                        document.getElementById('mesaiModalMsg').style.color = '#DC2626';
                    });
                }
            }
        }

        // ----- KAYDET MESAI -----
        async function kaydetMesai() {
            const baslangic = document.getElementById('mesaiBaslangic').value;
            const bitis = document.getElementById('mesaiBitis').value;
            const aciklama = document.getElementById('mesaiAciklama').value.trim();
            const msg = document.getElementById('mesaiModalMsg');

            msg.textContent = '';
            msg.style.color = '#DC2626';

            if (!baslangic || !bitis) {
                msg.textContent = 'Başlangıç ve bitiş saati zorunludur.';
                return;
            }

            // Süre kontrolü
            const farkDk = hesaplaSure();
            if (farkDk === null) {
                msg.textContent = 'Geçerli bir saat aralığı giriniz. Bitiş saati başlangıçtan sonra olmalıdır.';
                return;
            }

            // 8 saat kontrolü
            if (farkDk > 480) {
                msg.textContent = 'Günlük maksimum 8 saat mesai girilebilir!';
                return;
            }

            // 88 saat aylık kontrolü
            if (seciliHucre.personelId) {
                const toplamSpan = document.querySelector('.personel-toplam[data-personel-id="' + seciliHucre.personelId + '"] span');
                if (toplamSpan) {
                    const txt = toplamSpan.textContent.trim();
                    const parts = txt.split(':');
                    let mevcutToplam = 0;
                    if (parts.length === 2) {
                        mevcutToplam = parseInt(parts[0]) || 0;
                    }
                    const yeniToplam = mevcutToplam + (farkDk / 60);
                    if (yeniToplam > 88) {
                        msg.textContent = '⚠️ Bu kayıt ile aylık 88 saat aşılıyor! (Mevcut: ' + formatSaatDakika(mevcutToplam) + ')';
                        return;
                    }
                }
            }

            const payload = {
                personelId: seciliHucre.personelId,
                tarih: document.getElementById('mesaiTarih').value,
                baslangicSaati: baslangic,
                bitisSaati: bitis,
                notlar: aciklama
            };

            try {
                const endpoint = seciliHucre.mode === 'edit' ? '/HizliMesaiGirisi/Guncelle' : '/HizliMesaiGirisi/KayitEkle';
                const body = seciliHucre.mode === 'edit'
                    ? { id: seciliKayitId, baslangicSaati: baslangic, bitisSaati: bitis, notlar: aciklama }
                    : payload;

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                if (!response.ok) {
                    const text = await response.text();
                    msg.textContent = text || 'Kayıt sırasında hata oluştu.';
                    return;
                }

                modalInstance.hide();
                window.location.reload();
            } catch (err) {
                msg.textContent = 'Sunucuya bağlanılamadı.';
            }
        }

        // ----- TOPLU MESAI GİRİŞİ -----
        function acBatchModal() {
            document.getElementById('batchPersonel').value = '';
            document.getElementById('batchAciklama').value = '';
            document.getElementById('batchModalMsg').textContent = '';
            document.querySelectorAll('.batch-day-check').forEach(cb => {
                if (!cb.disabled) cb.checked = false;
            });
            batchModalInstance.show();
        }

        async function kaydetTopluMesai() {
            const personelId = document.getElementById('batchPersonel').value;
            const aciklama = document.getElementById('batchAciklama').value.trim();
            const msg = document.getElementById('batchModalMsg');

            if (!personelId) {
                msg.textContent = 'Lütfen bir personel seçiniz.';
                return;
            }

            const selectedDays = [];
            document.querySelectorAll('.batch-day-check:checked').forEach(cb => {
                const gun = parseInt(cb.value);
                const dayItem = cb.closest('.batch-day-item');
                const start = dayItem.querySelector('.batch-start').value;
                const end = dayItem.querySelector('.batch-end').value;
                if (start && end) {
                    selectedDays.push({ gun, start, end });
                }
            });

            if (selectedDays.length === 0) {
                msg.textContent = 'Lütfen en az bir gün seçiniz.';
                return;
            }

            // 88 saat kontrolü için mevcut toplamı al
            let mevcutToplam = 0;
            const toplamSpan = document.querySelector('.personel-toplam[data-personel-id="' + personelId + '"] span');
            if (toplamSpan) {
                const txt = toplamSpan.textContent.trim();
                const parts = txt.split(':');
                if (parts.length === 2) {
                    mevcutToplam = parseInt(parts[0]) || 0;
                }
            }

            // Seçilen günlerin toplam saatini hesapla
            let eklenecekToplam = 0;
            for (const day of selectedDays) {
                const basParts = day.start.split(':');
                const bitParts = day.end.split(':');
                const basSaat = parseInt(basParts[0]);
                const basDak = parseInt(basParts[1]);
                const bitSaat = parseInt(bitParts[0]);
                const bitDak = parseInt(bitParts[1]);
                const farkDk = (bitSaat * 60 + bitDak) - (basSaat * 60 + basDak);
                if (farkDk > 0) {
                    eklenecekToplam += farkDk / 60;
                }
            }

            if (mevcutToplam + eklenecekToplam > 88) {
                msg.textContent = '⚠️ Bu kayıtlar ile aylık 88 saat aşılıyor! (Mevcut: ' + formatSaatDakika(mevcutToplam) + ')';
                msg.style.color = '#DC2626';
                return;
            }

            msg.textContent = 'Kaydediliyor...';
            msg.style.color = '#2563EB';

            let basarili = 0;
            let hatali = 0;

            for (const day of selectedDays) {
                const tarih = `${@secilenYil}-${String(@secilenAy).padStart(2, '0')}-${String(day.gun).padStart(2, '0')}`;
                const payload = {
                    personelId: personelId,
                    tarih: tarih,
                    baslangicSaati: day.start,
                    bitisSaati: day.end,
                    notlar: aciklama
                };

                try {
                    const response = await fetch('/HizliMesaiGirisi/KayitEkle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) {
                        basarili++;
                    } else {
                        hatali++;
                    }
                } catch (err) {
                    hatali++;
                }
            }

            if (hatali === 0) {
                msg.textContent = `✅ ${basarili} gün başarıyla kaydedildi!`;
                msg.style.color = '#16A34A';
                setTimeout(() => {
                    batchModalInstance.hide();
                    window.location.reload();
                }, 1500);
            } else {
                msg.textContent = `⚠️ ${basarili} gün kaydedildi, ${hatali} günde hata oluştu.`;
                msg.style.color = '#DC2626';
            }
        }

        // ----- MESAI RAPORU -----
        function acReportModal() {
            const reportData = [];
            document.querySelectorAll('tbody tr').forEach(row => {
                const personelAd = row.querySelector('.sticky-personel')?.textContent?.trim() || '';
                const toplamSpan = row.querySelector('.personel-toplam span');
                if (toplamSpan) {
                    const txt = toplamSpan.textContent.trim();
                    const parts = txt.split(':');
                    if (parts.length === 2) {
                        const saat = parseInt(parts[0]) || 0;
                        const dakika = parseInt(parts[1]) || 0;
                        const toplamSaat = saat + (dakika / 60);
                        const gunSayisi = row.querySelectorAll('td[data-saat]').length;
                        reportData.push({
                            personel: personelAd,
                            toplam: toplamSaat,
                            gunSayisi: gunSayisi,
                            ortalama: gunSayisi > 0 ? toplamSaat / gunSayisi : 0
                        });
                    }
                }
            });

            reportData.sort((a, b) => b.toplam - a.toplam);

            const tbody = document.getElementById('reportTableBody');
            if (reportData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Veri bulunmuyor</td></tr>';
            } else {
                tbody.innerHTML = reportData.map(d => `
                    <tr>
                        <td><strong>${d.personel}</strong></td>
                        <td>${formatSaatDakika(d.toplam)}</td>
                        <td>${formatSaatDakika(d.ortalama)}</td>
                        <td>${d.gunSayisi} gün</td>
                    </tr>
                `).join('');
            }

            const toplamMesai = reportData.reduce((sum, d) => sum + d.toplam, 0);
            const ortalamaMesai = reportData.length > 0 ? toplamMesai / reportData.length : 0;
            document.getElementById('reportTopPersonel').textContent = reportData.length > 0 ? reportData[0].personel : '-';
            document.getElementById('reportToplamMesai').textContent = formatSaatDakika(toplamMesai);
            document.getElementById('reportOrtalama').textContent = formatSaatDakika(ortalamaMesai);

            reportModalInstance.show();
        }

        // ----- EXCEL / PDF / YAZDIR -----
        function takvimKaydet() {
            setTakvimMsg('Değişiklikler otomatik olarak kaydedilir.');
        }

        function setTakvimMsg(text, isError = false) {
            const el = document.getElementById('takvimActionMsg');
            if (el) {
                el.textContent = text;
                el.style.color = isError ? '#b91c1c' : '#64748b';
            }
        }

        function takvimExcelAktar() {
            const table = document.querySelector('.mesai-table');
            if (!table) { setTakvimMsg('Tablo bulunamadı.', true); return; }
            const tbl = table.cloneNode(true);
            tbl.querySelectorAll('.no-print').forEach(el => el.remove());
            const html = `<html><head><meta charset="UTF-8"><style>th,td{border:1px solid #000;padding:4px;text-align:center;font-size:10px;}th{background:#1e3c72;color:white;font-weight:bold;}</style></head><body>${tbl.outerHTML}</body></html>`;
            const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=UTF-8' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Mesai_Takvimi.xls';
            document.body.appendChild(link);
            link.click();
            link.remove();
            setTakvimMsg('Excel indiriliyor...');
        }

        function renderPrintLayout() {
            const table = document.querySelector('.mesai-table');
            if (!table) { setTakvimMsg('Tablo bulunamadı.', true); return null; }
            const clone = table.cloneNode(true);
            clone.querySelectorAll('.no-print').forEach(el => el.remove());
            const wrap = document.createElement('div');
            wrap.style.cssText = 'width:1100px;padding:15px;font-family:Inter,sans-serif;background:white;';
            wrap.innerHTML = `<div style="text-align:center;margin-bottom:10px;"><h3 style="font-size:16px;">GAMABEL YATIRIM LTD</h3><h4 style="font-size:14px;">HIZLI MESAİ GİRİŞİ</h4></div>`;
            wrap.appendChild(clone);
            return wrap;
        }

        function takvimPdfIndir() {
            const layout = renderPrintLayout();
            if (!layout) return;
            document.body.appendChild(layout);
            html2pdf().set({ margin: 5, filename: 'Mesai_Takvimi.pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' } })
                .from(layout).save().then(() => { layout.remove(); setTakvimMsg('PDF indiriliyor...'); });
        }

        function takvimYazdir() {
            const layout = renderPrintLayout();
            if (!layout) return;
            const container = document.createElement('div');
            container.id = 'printContainer';
            container.appendChild(layout);
            document.body.appendChild(container);
            setTimeout(() => window.print(), 300);
            window.addEventListener('afterprint', () => container.remove(), { once: true });
        }
    </script>

</body>
</html>