    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        // ----- GLOBAL STATE -----
        let seciliHucre = { personelId: 0, gun: 0, mode: 'new' };
        let seciliKayitId = 0;
        let modalInstance = null;
        let batchModalInstance = null;
        let reportModalInstance = null;
        let silModu = false;

        document.addEventListener('DOMContentLoaded', function() {
            // Bootstrap modal init
            const modalEl = document.getElementById('mesaiModal');
            modalInstance = new bootstrap.Modal(modalEl);
            
            const batchModalEl = document.getElementById('batchModal');
            batchModalInstance = new bootstrap.Modal(batchModalEl);
            
            const reportModalEl = document.getElementById('reportModal');
            reportModalInstance = new bootstrap.Modal(reportModalEl);

            // Modal açıldığında verileri yükle
            modalEl.addEventListener('show.bs.modal', function() {
                if (seciliHucre.mode === 'edit' && seciliKayitId > 0) {
                    mesaiVerileriniGetir(seciliKayitId);
                }
            });

            hesaplaToplamlar();
            istatistikleriGuncelle();
            hesaplaDetayliToplamlar();
            kontrol88SaatUyarisi();

            // tooltipleri aktif et
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(el => new bootstrap.Tooltip(el));
        });

        // ----- MESAI VERİLERİNİ GETİR (Düzenleme için) -----
        async function mesaiVerileriniGetir(kayitId) {
            try {
                const response = await fetch('/HizliMesaiGirisi/GetMesaiDetay?kayitId=' + kayitId);
                if (response.ok) {
                    const data = await response.json();
                    if (data.baslangic) {
                        document.getElementById('mesaiBaslangic').value = data.baslangic;
                    }
                    if (data.bitis) {
                        document.getElementById('mesaiBitis').value = data.bitis;
                    }
                    if (data.aciklama) {
                        document.getElementById('mesaiAciklama').value = data.aciklama;
                    }
                    // Sil butonunu göster
                    document.getElementById('btnSilMesai').style.display = 'inline-block';
                    hesaplaSure();
                }
            } catch (err) {
                console.error('Veri getirme hatası:', err);
            }
        }

        // ----- TOPLAM HESAPLAMA (saat toplamları) -----
        function hesaplaToplamlar() {
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                let toplam = 0;
                const cells = row.querySelectorAll('td[data-saat]');
                cells.forEach(cell => {
                    const val = parseFloat(cell.getAttribute('data-saat')) || 0;
                    toplam += val;
                });
                const toplamCell = row.querySelector('.personel-toplam span');
                if (toplamCell) {
                    toplamCell.textContent = formatSaatDakika(toplam);
                }
            });
        }

        // ----- DETAYLI TOPLAM HESAPLAMA (Normal + Hafta Sonu) -----
        function hesaplaDetayliToplamlar() {
            const rows = document.querySelectorAll('tbody tr');
            rows.forEach(row => {
                let normalToplam = 0;
                let haftaSonuToplam = 0;
                let toplam = 0;
                const cells = row.querySelectorAll('td[data-saat]');
                const gunIndex = 0;
                cells.forEach(cell => {
                    const val = parseFloat(cell.getAttribute('data-saat')) || 0;
                    const gun = parseInt(cell.getAttribute('data-gun'));
                    toplam += val;
                    
                    // Hafta sonu kontrolü
                    const tarih = new Date(@secilenYil, @secilenAy - 1, gun);
                    const isWeekend = tarih.getDay() === 0 || tarih.getDay() === 6;
                    if (isWeekend) {
                        haftaSonuToplam += val;
                    } else {
                        normalToplam += val;
                    }
                });
                
                const detayCell = row.querySelector('.personel-toplam-detay');
                if (detayCell) {
                    const normalSpan = detayCell.querySelector('.normal-saat');
                    const ekstraSpan = detayCell.querySelector('.ekstra-saat');
                    const toplamSpan = detayCell.querySelector('.toplam-saat');
                    
                    if (normalSpan) normalSpan.textContent = formatSaatDakika(normalToplam);
                    if (ekstraSpan) ekstraSpan.textContent = '+' + formatSaatDakika(haftaSonuToplam);
                    if (toplamSpan) toplamSpan.textContent = formatSaatDakika(toplam);
                }
            });
        }

        function formatSaatDakika(saat) {
            if (saat === null || saat === undefined || saat === '') {
                return '0:00';
            }

            if (typeof saat === 'string') {
                const raw = saat.trim();
                if (raw.includes(':')) {
                    const parts = raw.split(':');
                    if (parts.length === 2) {
                        let h = parseInt(parts[0], 10) || 0;
                        let m = parseInt(parts[1], 10) || 0;
                        if (m >= 60) {
                            h += Math.floor(m / 60);
                            m = m % 60;
                        }
                        return h + ':' + String(m).padStart(2, '0');
                    }
                }
                saat = parseFloat(raw.replace(',', '.'));
            }

            const num = Number(saat);
            if (Number.isNaN(num)) {
                return '0:00';
            }

            const s = Math.floor(num);
            let d = Math.round((num - s) * 60);
            if (d >= 60) {
                d = 0;
            }
            return s + ':' + String(d).padStart(2, '0');
        }

        // ----- İSTATİSTİK KARTLARI -----
        function istatistikleriGuncelle() {
            let toplamSaat = 0;
            document.querySelectorAll('.personel-toplam span').forEach(el => {
                const txt = el.textContent.trim();
                const parts = txt.split(':');
                if (parts.length === 2) {
                    const s = parseInt(parts[0]) || 0;
                    const d = parseInt(parts[1]) || 0;
                    toplamSaat += s + (d / 60);
                }
            });
            const toplamSaatEl = document.getElementById('toplamMesaiSaat');
            if (toplamSaatEl) {
                toplamSaatEl.textContent = Math.round(toplamSaat) + ' Saat';
            }
        }

        // ----- 88 SAAT UYARISI -----
        function kontrol88SaatUyarisi() {
            document.querySelectorAll('.personel-toplam').forEach(el => {
                const span = el.querySelector('span');
                if (!span) return;
                const txt = span.textContent.trim();
                const parts = txt.split(':');
                let toplam = 0;
                if (parts.length === 2) {
                    toplam = parseInt(parts[0]) || 0;
                }
                if (toplam > 88) {
                    el.classList.add('uyari-aylik');
                    el.title = 'Aylık 88 saat kotası aşıldı!';
                } else {
                    el.classList.remove('uyari-aylik');
                    el.title = '';
                }
            });
        }

        // ----- SAAT HESAPLAMA (Canlı) -----
        function hesaplaSure() {
            const baslangic = document.getElementById('mesaiBaslangic').value;
            const bitis = document.getElementById('mesaiBitis').value;
            const bilgiEl = document.getElementById('mesaiSureBilgi');
            const uyariEl = document.getElementById('mesaiAylikUyari');
            
            if (!baslangic || !bitis) {
                bilgiEl.textContent = 'Süre: —';
                return null;
            }

            const basParts = baslangic.split(':');
            const bitParts = bitis.split(':');
            
            if (basParts.length !== 2 || bitParts.length !== 2) {
                bilgiEl.textContent = 'Süre: Geçersiz format';
                return null;
            }

            const basSaat = parseInt(basParts[0]);
            const basDak = parseInt(basParts[1]);
            const bitSaat = parseInt(bitParts[0]);
            const bitDak = parseInt(bitParts[1]);

            const basToplamDak = basSaat * 60 + basDak;
            const bitToplamDak = bitSaat * 60 + bitDak;
            let farkDk = bitToplamDak - basToplamDak;

            if (farkDk <= 0) {
                bilgiEl.textContent = 'Bitiş saati başlangıçtan sonra olmalıdır!';
                bilgiEl.style.color = '#DC2626';
                return null;
            }

            // 8 saat kontrolü
            if (farkDk > 480) {
                bilgiEl.textContent = '⚠️ 8 saatten fazla mesai girilemez!';
                bilgiEl.style.color = '#DC2626';
                return null;
            }

            bilgiEl.style.color = '#475569';
            const saat = Math.floor(farkDk / 60);
            const dakika = farkDk % 60;
            bilgiEl.textContent = 'Süre: ' + saat + ' saat ' + dakika + ' dk';

            // Aylık 88 saat kontrolü
            if (seciliHucre.personelId > 0) {
                const toplamSpan = document.querySelector('.personel-toplam[data-personel-id="' + seciliHucre.personelId + '"] span');
                if (toplamSpan) {
                    const txt = toplamSpan.textContent.trim();
                    const parts = txt.split(':');
                    let mevcutToplam = 0;
                    if (parts.length === 2) {
                        mevcutToplam = parseInt(parts[0]) || 0;
                    }
                    const yeniToplam = mevcutToplam + (farkDk / 60);
                    if (yeniToplam > 88) {
                        uyariEl.style.display = 'block';
                        uyariEl.textContent = '⚠️ Bu kayıt ile aylık 88 saat aşılıyor! (Mevcut: ' + formatSaatDakika(mevcutToplam) + ')';
                    } else {
                        uyariEl.style.display = 'none';
                    }
                }
            }

            return farkDk;
        }

        // ----- NAVIGATION -----
        function birimSecildi() {
            const birim = document.getElementById('subeSelect').value;
            if (birim) {
                window.location.href = `/HizliMesaiGirisi/Index?birim=${encodeURIComponent(birim)}&yil=@secilenYil&ay=@secilenAy`;
            }
        }

        function ayDegistir(miktar) {
            let ay = @secilenAy + miktar;
            let yil = @secilenYil;
            if (ay > 12) { ay = 1; yil++; }
            else if (ay < 1) { ay = 12; yil--; }
            const birim = document.getElementById('subeSelect').value;
            if (birim) {
                window.location.href = `/HizliMesaiGirisi/Index?birim=${encodeURIComponent(birim)}&yil=${yil}&ay=${ay}`;
            }
        }

        // ----- TEKİL MODAL OPERATIONS -----
        function yeniMesaiEkle(personelId, gun) {
            seciliHucre = { personelId, gun, mode: 'new' };
            seciliKayitId = 0;
            const tarih = `${@secilenYil}-${String(@secilenAy).padStart(2, '0')}-${String(gun).padStart(2, '0')}`;
            document.getElementById('mesaiTarih').value = tarih;
            document.getElementById('mesaiModalTitle').textContent = 'Mesai Girişi';
            document.getElementById('mesaiModalMsg').textContent = '';
            document.getElementById('mesaiBaslangic').value = '08:00';
            document.getElementById('mesaiBitis').value = '17:00';
            document.getElementById('mesaiAciklama').value = '';
            document.getElementById('mesaiSureBilgi').textContent = 'Süre: —';
            document.getElementById('mesaiSureBilgi').style.color = '#475569';
            document.getElementById('mesaiAylikUyari').style.display = 'none';
            document.getElementById('btnSilMesai').style.display = 'none';
            modalInstance.show();
        }

        function mesaiDetay(personelId, gun, kayitId) {
            seciliHucre = { personelId, gun, mode: 'edit' };
            seciliKayitId = kayitId || 0;
            const tarih = `${@secilenYil}-${String(@secilenAy).padStart(2, '0')}-${String(gun).padStart(2, '0')}`;
            document.getElementById('mesaiTarih').value = tarih;
            document.getElementById('mesaiModalTitle').textContent = 'Mesai Güncelle';
            document.getElementById('mesaiModalMsg').textContent = '';
            document.getElementById('mesaiAciklama').value = '';
            document.getElementById('btnSilMesai').style.display = 'inline-block';
            document.getElementById('mesaiSureBilgi').textContent = 'Süre: —';
            document.getElementById('mesaiSureBilgi').style.color = '#475569';
            document.getElementById('mesaiAylikUyari').style.display = 'none';
            
            // Verileri getir
            mesaiVerileriniGetir(kayitId);
            
            modalInstance.show();
        }

        // ----- MESAI SİLME (Sağ Tık ile) -----
        function silMesai(event, personelId, gun, kayitId) {
            event.preventDefault();
            if (confirm('Bu mesai kaydını silmek istediğinizden emin misiniz?')) {
                fetch('/HizliMesaiGirisi/Sil', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(kayitId)
                })
                .then(function(response) {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alert('Silme işlemi başarısız oldu.');
                    }
                })
                .catch(function() {
                    alert('Sunucu hatası!');
                });
            }
        }

        // ----- SİL BUTONU (Modal içinden) -----
        function silMesaiKaydi() {
            if (seciliKayitId > 0) {
                if (confirm('Bu mesai kaydını silmek istediğinizden emin misiniz?')) {
                    fetch('/HizliMesaiGirisi/Sil', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(seciliKayitId)
                    })
                    .then(function(response) {
                        if (response.ok) {
                            modalInstance.hide();
                            window.location.reload();
                        } else {
                            document.getElementById('mesaiModalMsg').textContent = 'Silme işlemi başarısız oldu.';
                            document.getElementById('mesaiModalMsg').style.color = '#DC2626';
                        }
                    })
                    .catch(function() {
                        document.getElementById('mesaiModalMsg').textContent = 'Sunucu hatası!';
                        document.getElementById('mesaiModalMsg').style.color = '#DC2626';
                    });
                }
            }
        }

        // ----- KAYDET MESAI -----
        async function kaydetMesai() {
            const baslangic = document.getElementById('mesaiBaslangic').value;
            const bitis = document.getElementById('mesaiBitis').value;
            const aciklama = document.getElementById('mesaiAciklama').value.trim();
            const msg = document.getElementById('mesaiModalMsg');

            msg.textContent = '';
            msg.style.color = '#DC2626';

            if (!baslangic || !bitis) {
                msg.textContent = 'Başlangıç ve bitiş saati zorunludur.';
                return;
            }

            // Süre kontrolü
            const farkDk = hesaplaSure();
            if (farkDk === null) {
                msg.textContent = 'Geçerli bir saat aralığı giriniz. Bitiş saati başlangıçtan sonra olmalıdır.';
                return;
            }

            // 8 saat kontrolü
            if (farkDk > 480) {
                msg.textContent = 'Günlük maksimum 8 saat mesai girilebilir!';
                return;
            }

            // 88 saat aylık kontrolü
            if (seciliHucre.personelId > 0) {
                const toplamSpan = document.querySelector('.personel-toplam[data-personel-id="' + seciliHucre.personelId + '"] span');
                if (toplamSpan) {
                    const txt = toplamSpan.textContent.trim();
                    const parts = txt.split(':');
                    let mevcutToplam = 0;
                    if (parts.length === 2) {
                        mevcutToplam = parseInt(parts[0]) || 0;
                    }
                    const yeniToplam = mevcutToplam + (farkDk / 60);
                    if (yeniToplam > 88) {
                        msg.textContent = '⚠️ Bu kayıt ile aylık 88 saat aşılıyor! (Mevcut: ' + formatSaatDakika(mevcutToplam) + ')';
                        return;
                    }
                }
            }

            const payload = {
                personelId: seciliHucre.personelId,
                tarih: document.getElementById('mesaiTarih').value,
                baslangicSaati: baslangic,
                bitisSaati: bitis,
                notlar: aciklama
            };

            try {
                const endpoint = seciliHucre.mode === 'edit' ? '/HizliMesaiGirisi/Guncelle' : '/HizliMesaiGirisi/KayitEkle';
                const body = seciliHucre.mode === 'edit'
                    ? { id: seciliKayitId, baslangicSaati: baslangic, bitisSaati: bitis, notlar: aciklama }
                    : payload;

                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });

                if (!response.ok) {
                    const text = await response.text();
                    msg.textContent = text || 'Kayıt sırasında hata oluştu.';
                    return;
                }

                modalInstance.hide();
                window.location.reload();
            } catch (err) {
                msg.textContent = 'Sunucuya bağlanılamadı.';
            }
        }

        // ----- TOPLU MESAI GİRİŞİ -----
        function acBatchModal() {
            document.getElementById('batchPersonel').value = '';
            document.getElementById('batchAciklama').value = '';
            document.getElementById('batchModalMsg').textContent = '';
            document.querySelectorAll('.batch-day-check').forEach(cb => {
                if (!cb.disabled) cb.checked = false;
            });
            batchModalInstance.show();
        }

        async function kaydetTopluMesai() {
            const personelId = document.getElementById('batchPersonel').value;
            const aciklama = document.getElementById('batchAciklama').value.trim();
            const msg = document.getElementById('batchModalMsg');

            if (!personelId) {
                msg.textContent = 'Lütfen bir personel seçiniz.';
                return;
            }

            const selectedDays = [];
            document.querySelectorAll('.batch-day-check:checked').forEach(cb => {
                const gun = parseInt(cb.value);
                const dayItem = cb.closest('.batch-day-item');
                const start = dayItem.querySelector('.batch-start').value;
                const end = dayItem.querySelector('.batch-end').value;
                if (start && end) {
                    selectedDays.push({ gun, start, end });
                }
            });

            if (selectedDays.length === 0) {
                msg.textContent = 'Lütfen en az bir gün seçiniz.';
                return;
            }

            // 88 saat kontrolü için mevcut toplamı al
            let mevcutToplam = 0;
            const toplamSpan = document.querySelector('.personel-toplam[data-personel-id="' + personelId + '"] span');
            if (toplamSpan) {
                const txt = toplamSpan.textContent.trim();
                const parts = txt.split(':');
                if (parts.length === 2) {
                    mevcutToplam = parseInt(parts[0]) || 0;
                }
            }

            // Seçilen günlerin toplam saatini hesapla
            let eklenecekToplam = 0;
            for (const day of selectedDays) {
                const basParts = day.start.split(':');
                const bitParts = day.end.split(':');
                const basSaat = parseInt(basParts[0]);
                const basDak = parseInt(basParts[1]);
                const bitSaat = parseInt(bitParts[0]);
                const bitDak = parseInt(bitParts[1]);
                const farkDk = (bitSaat * 60 + bitDak) - (basSaat * 60 + basDak);
                if (farkDk > 0) {
                    eklenecekToplam += farkDk / 60;
                }
            }

            if (mevcutToplam + eklenecekToplam > 88) {
                msg.textContent = '⚠️ Bu kayıtlar ile aylık 88 saat aşılıyor! (Mevcut: ' + formatSaatDakika(mevcutToplam) + ')';
                msg.style.color = '#DC2626';
                return;
            }

            msg.textContent = 'Kaydediliyor...';
            msg.style.color = '#2563EB';

            let basarili = 0;
            let hatali = 0;

            for (const day of selectedDays) {
                const tarih = `${@secilenYil}-${String(@secilenAy).padStart(2, '0')}-${String(day.gun).padStart(2, '0')}`;
                const payload = {
                    personelId: parseInt(personelId),
                    tarih: tarih,
                    baslangicSaati: day.start,
                    bitisSaati: day.end,
                    notlar: aciklama
                };

                try {
                    const response = await fetch('/HizliMesaiGirisi/KayitEkle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) {
                        basarili++;
                    } else {
                        hatali++;
                    }
                } catch (err) {
                    hatali++;
                }
            }

            if (hatali === 0) {
                msg.textContent = `✅ ${basarili} gün başarıyla kaydedildi!`;
                msg.style.color = '#16A34A';
                setTimeout(() => {
                    batchModalInstance.hide();
                    window.location.reload();
                }, 1500);
            } else {
                msg.textContent = `⚠️ ${basarili} gün kaydedildi, ${hatali} günde hata oluştu.`;
                msg.style.color = '#DC2626';
            }
        }

        // ----- MESAI RAPORU -----
        function acReportModal() {
            const reportData = [];
            document.querySelectorAll('tbody tr').forEach(row => {
                const personelAd = row.querySelector('.sticky-personel')?.textContent?.trim() || '';
                const toplamSpan = row.querySelector('.personel-toplam span');
                if (toplamSpan) {
                    const txt = toplamSpan.textContent.trim();
                    const parts = txt.split(':');
                    if (parts.length === 2) {
                        const saat = parseInt(parts[0]) || 0;
                        const dakika = parseInt(parts[1]) || 0;
                        const toplamSaat = saat + (dakika / 60);
                        const gunSayisi = row.querySelectorAll('td[data-saat]').length;
                        reportData.push({
                            personel: personelAd,
                            toplam: toplamSaat,
                            gunSayisi: gunSayisi,
                            ortalama: gunSayisi > 0 ? toplamSaat / gunSayisi : 0
                        });
                    }
                }
            });

            reportData.sort((a, b) => b.toplam - a.toplam);

            const tbody = document.getElementById('reportTableBody');
            if (reportData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">Veri bulunmuyor</td></tr>';
            } else {
                tbody.innerHTML = reportData.map(d => `
                    <tr>
                        <td><strong>${d.personel}</strong></td>
                        <td>${formatSaatDakika(d.toplam)}</td>
                        <td>${formatSaatDakika(d.ortalama)}</td>
                        <td>${d.gunSayisi} gün</td>
                    </tr>
                `).join('');
            }

            const toplamMesai = reportData.reduce((sum, d) => sum + d.toplam, 0);
            const ortalamaMesai = reportData.length > 0 ? toplamMesai / reportData.length : 0;
            document.getElementById('reportTopPersonel').textContent = reportData.length > 0 ? reportData[0].personel : '-';
            document.getElementById('reportToplamMesai').textContent = formatSaatDakika(toplamMesai);
            document.getElementById('reportOrtalama').textContent = formatSaatDakika(ortalamaMesai);

            reportModalInstance.show();
        }

        // ----- EXCEL / PDF / YAZDIR -----
        function takvimKaydet() {
            setTakvimMsg('Değişiklikler otomatik olarak kaydedilir.');
        }

        function setTakvimMsg(text, isError = false) {
            const el = document.getElementById('takvimActionMsg');
            if (el) {
                el.textContent = text;
                el.style.color = isError ? '#b91c1c' : '#64748b';
            }
        }

        function takvimExcelAktar() {
            const table = document.querySelector('.mesai-table');
            if (!table) { setTakvimMsg('Tablo bulunamadı.', true); return; }
            const tbl = table.cloneNode(true);
            tbl.querySelectorAll('.no-print').forEach(el => el.remove());
            const html = `<html><head><meta charset="UTF-8"><style>th,td{border:1px solid #000;padding:4px;text-align:center;font-size:10px;}th{background:#1e3c72;color:white;font-weight:bold;}</style></head><body>${tbl.outerHTML}</body></html>`;
            const blob = new Blob([html], { type: 'application/vnd.ms-excel;charset=UTF-8' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Mesai_Takvimi.xls';
            document.body.appendChild(link);
            link.click();
            link.remove();
            setTakvimMsg('Excel indiriliyor...');
        }

        function renderPrintLayout() {
            const table = document.querySelector('.mesai-table');
            if (!table) { setTakvimMsg('Tablo bulunamadı.', true); return null; }
            const clone = table.cloneNode(true);
            clone.querySelectorAll('.no-print').forEach(el => el.remove());
            const wrap = document.createElement('div');
            wrap.style.cssText = 'width:1100px;padding:15px;font-family:Inter,sans-serif;background:white;';
            wrap.innerHTML = `<div style="text-align:center;margin-bottom:10px;"><h3 style="font-size:16px;">GAMABEL YATIRIM LTD</h3><h4 style="font-size:14px;">HIZLI MESAİ GİRİŞİ</h4></div>`;
            wrap.appendChild(clone);
            return wrap;
        }

        function takvimPdfIndir() {
            const layout = renderPrintLayout();
            if (!layout) return;
            document.body.appendChild(layout);
            html2pdf().set({ margin: 5, filename: 'Mesai_Takvimi.pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' } })
                .from(layout).save().then(() => { layout.remove(); setTakvimMsg('PDF indiriliyor...'); });
        }

        function takvimYazdir() {
            const layout = renderPrintLayout();
            if (!layout) return;
            const container = document.createElement('div');
            container.id = 'printContainer';
            container.appendChild(layout);
            document.body.appendChild(container);
            setTimeout(() => window.print(), 300);
            window.addEventListener('afterprint', () => container.remove(), { once: true });
        }
    </script>

