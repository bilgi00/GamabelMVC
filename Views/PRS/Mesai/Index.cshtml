@{
    ViewData["Title"] = "Ek Mesai Çizelgesi";
    Layout = "_Layout";
    var currentYear = DateTime.Now.Year;
    var yearRangeStart = currentYear - 2;
}

<style>
    /* Sayfa-özel stiller (tablo, imza alanı, animasyonlar).
       Genel kart / filtre çubuğu standartı site.css'tedir:
       .sayfa-karti, .filtre-cubugu, .filtre-alan(-genis), .filtre-sabit
       (bkz. CSS_DESIGN_SYSTEM.md → Genel Tasarım Standardı) */

    .mesai-filtre-cubugu {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
    }

    @@media (max-width: 767.98px) {
        .mesai-filtre-cubugu {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .mesai-filtre-cubugu {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    /* Tablo Stilleri */
    .mesai-table { min-width: 1200px; font-size: 0.875rem; border-radius: 0; }
    .mesai-table td { padding: 0.375rem 0.5rem; }
    .readonly-cell { background-color: #f5f5f5; font-weight: 600; font-size: 0.6875rem; }
    .mesai-table input[type="date"] { box-sizing: border-box; width: 145px; min-width: 145px; }
    .mesai-table input[type="time"] { box-sizing: border-box; width: 120px; min-width: 120px; }
    
    /* İmza Alanı */
    .signature-box { text-align: center; flex: 1 1 45%; min-width: 200px; }
    .signature-line { border-top: 1px solid #000; margin: 2.5rem 0 0.25rem 0; height: 40px; }
    .signature-title { font-size: 0.6875rem; font-weight: bold; margin-bottom: 0.25rem; }
    
    /* Animasyonlar */
    .toast-msg { animation: slideIn 0.3s ease; }
    @@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
    @@keyframes popupIn { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    
    /* Print Ayarları */
    @@print {
        .no-print { display: none !important; }
        .navbar, footer { display: none !important; }
    }

</style>

<!-- Ay Kilitli Popup Modal -->
<div class="modal" id="kilitPopupOverlay" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-danger">
                <h5 class="modal-title text-danger">🔒 Ay Kilitli</h5>
                <button type="button" class="btn-close" id="kilitPopupBtn"></button>
            </div>
            <div class="modal-body text-center">
                <p id="kilitPopupMesaj" class="text-muted"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="kilitPopupBtn2" data-bs-dismiss="modal">Tamam</button>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <!-- Başlık -->
    <sayfa-baslik baslik="EK MESAİ ÇİZELGESİ"
                  aciklama="Personel mesai takip formu — Çalışma saatleri otomatik hesaplanır."
                  ikon="fa-clock">
        <button class="btn btn-sm btn-warning text-dark" id="btnSatirEkle" disabled>+ Satır Ekle (Tüm)</button>
        <button class="btn btn-sm btn-warning text-dark" id="btnSatirEkleBirim" disabled>+ Satır (Birim)</button>
        <button type="button" class="btn btn-sm btn-info text-white" id="btnOnizlemeYatay" disabled>Önizleme (Yatay)</button>
        <button type="button" class="btn btn-sm btn-success" id="btnExcelYatay" disabled>Excel</button>
        <button type="button" class="btn btn-sm btn-secondary" id="btnHtmlYatay" disabled>HTML</button>
        <button type="button" class="btn btn-sm btn-danger" id="btnPdfYatay" disabled>PDF</button>
    </sayfa-baslik>

    <!-- Kontroller — genel standart: .sayfa-karti + .filtre-cubugu (ölçüler HizliMesaiGirisi hm- standardı) -->
    <section class="sayfa-karti filtre-cubugu mesai-filtre-cubugu no-print" aria-label="Filtreler">
        <select id="birimSelect" class="form-select filtre-alan" aria-label="Birim" @(ViewBag.Rol != "admin" ? "disabled" : "")>
            @if (ViewBag.Rol == "admin")
            {
                <option value="">-- Birim --</option>
                <option value="all">Tüm Personeller</option>
            }
            @if (ViewBag.Birimler != null)
            {
                @foreach (string birim in ViewBag.Birimler)
                {
                    if (ViewBag.Rol != "admin")
                    {
                        @:<option value="@birim" selected>@birim</option>
                    }
                    else
                    {
                        @:<option value="@birim">@birim</option>
                    }
                }
            }
        </select>
        <select id="personelRaporSelect" class="form-select filtre-alan" aria-label="Rapor personeli" title="Rapor alınacak personeli seçin; boş bırakılırsa tüm personel dahil edilir">
            <option value="">Rapor: Tüm Personeller</option>
        </select>
        <select id="yearSelect" class="form-select filtre-alan" aria-label="Yıl">
            @for (var y = yearRangeStart; y <= currentYear + 1; y++)
            {
                if (y == currentYear)
                {
                    <option value="@y" selected>@y</option>
                }
                else
                {
                    <option value="@y">@y</option>
                }
            }
        </select>
        <select id="monthSelect" class="form-select filtre-alan" aria-label="Ay">
            <option value="1">Ocak</option><option value="2">Şubat</option><option value="3">Mart</option>
            <option value="4">Nisan</option><option value="5">Mayıs</option><option value="6">Haziran</option>
            <option value="7">Temmuz</option><option value="8">Ağustos</option><option value="9">Eylül</option>
            <option value="10">Ekim</option><option value="11">Kasım</option><option value="12">Aralık</option>
        </select>
        <button class="btn btn-sm btn-primary" id="btnYukle">Yükle</button>
    </section>
    <div id="ayKilitUyari" class="alert alert-warning d-none" role="status"></div>

    <!-- Tablo -->
    <section class="sayfa-karti overflow-hidden" aria-label="Mesai çizelgesi">
        <div class="table-responsive">
            <table class="mesai-table table table-sm table-bordered mb-0" id="mesaiTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:140px;">Adı Soyadı</th>
                        <th style="width:160px;">Tarih</th>
                        <th style="width:80px;">Gün</th>
                        <th style="width:140px;">Başlangıç</th>
                        <th style="width:140px;">Bitiş</th>
                        <th style="width:80px;">Fiili (Saat)</th>
                        <th style="width:75px;">Zam 0.1</th>
                        <th style="width:75px;">Zam 0.5</th>
                        <th style="width:85px;">TOPLAM</th>
                        <th style="width:200px;">Açıklama</th>
                        <th style="width:40px;">İşlem</th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
                <tfoot>
                    <tr class="table-secondary fw-bold">
                        <td colspan="5" class="text-end" style="width:600px">GENEL TOPLAM</td>
                        <td id="tfFiili" style="width:80px">0</td>
                        <td id="tfZam01" style="width:75px">0</td>
                        <td id="tfZam05" style="width:75px">0</td>
                        <td id="tfToplam" style="width:85px">0</td>
                        <td style="width:150px;"></td>
                        <td style="width:70px;"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Footer -->
        <div class="bg-light border-top p-3 d-flex justify-content-between flex-wrap gap-3 small text-muted">
            <span>AÇIKLAMA: Zam 0.1 = Fiili Saat x 0,1 (hafta içi) | Zam 0.5 = Fiili Saat x 0,5 (Hafta sonu + Resmi Tatil)</span>
            <span>Toplam Mesai: <strong id="footerToplam">0</strong> saat</span>
        </div>
    </section>
</div>

<!-- Satır Ekleme Modalı -->
<div class="modal fade" id="satirEkleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Mesai Satırı Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Personel</label>
                    <select id="modalPersonel" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tarih</label>
                    <input type="date" id="modalTarih" class="form-control" />
                </div>
                <div class="row mb-3">
                    <div class="col">
                        <label class="form-label fw-bold">Başlangıç</label>
                        <input type="time" id="modalBaslangic" class="form-control" value="17:00" />
                    </div>
                    <div class="col">
                        <label class="form-label fw-bold">Bitiş</label>
                        <input type="time" id="modalBitis" class="form-control" value="22:00" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Açıklama</label>
                    <input type="text" id="modalAciklama" class="form-control" placeholder="İsteğe bağlı açıklama" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success" id="btnModalEkle">Ekle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    var personelListesi = [];
    var mesaiKayitlari = [];
    var currentBirim = '';
    var saatlikBrut = 0;
    var resmiTatiller = {};
    var ayKilitli = true;
    var ayKilitKontrolHazir = false;
    var mesaiYuklemeNo = 0;

    var gunAdlari = ['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
    var ayAdlari = ['','Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];

    function ayKilitDurumunuGoster(kilitli, mesaj) {
        ayKilitli = kilitli;
        var uyari = document.getElementById('ayKilitUyari');
        uyari.textContent = mesaj || (kilitli ? 'Seçili ay kilitli. Mesai kayıtları eklenemez, değiştirilemez veya silinemez.' : '');
        uyari.classList.toggle('d-none', !mesaj && !kilitli);
        document.getElementById('btnSatirEkle').disabled = !ayKilitKontrolHazir || kilitli;
        document.getElementById('btnSatirEkleBirim').disabled = !ayKilitKontrolHazir || kilitli;
        renderTable();
    }

    function initDateSelects() {
        var yearSel = document.getElementById('yearSelect');
        var monthSel = document.getElementById('monthSelect');

        if (!yearSel || !monthSel) {
            return;
        }

        yearSel.innerHTML = '';
        var now = new Date();
        for (var y = now.getFullYear() - 2; y <= now.getFullYear() + 1; y++) {
            var opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            if (y === now.getFullYear()) opt.selected = true;
            yearSel.appendChild(opt);
        }
        yearSel.value = now.getFullYear();
        monthSel.value = now.getMonth() + 1;
    }

    // Saat farkı hesapla
    function saatFarki(bas, bit) {
        if (!bas || !bit) return 0;
        var bp = bas.split(':').map(Number), bip = bit.split(':').map(Number);
        var fark = (bip[0]*60 + bip[1]) - (bp[0]*60 + bp[1]);
        if (fark < 0) fark += 1440;
        return Math.round(fark / 60 * 100) / 100;
    }

    // Zam otomatik hesaplama
    // Zam 0.1: Hafta içi fiili saat * 0.1
    // Zam 0.5: Hafta sonu ve resmi tatil fiili saat * 0.5
    function hesaplaZamlar(tarih, bas, bit) {
        var result = { fiili: 0, zam01: 0, zam05: 0, toplam: 0 };
        if (!tarih || !bas || !bit) return result;
        var gun = new Date(tarih).getDay(); // 0=Pazar, 6=Cumartesi
        var toplamSaat = saatFarki(bas, bit);
        result.fiili = toplamSaat;

        var tatilMi = resmiTatiller.hasOwnProperty(tarih);

        if (gun === 0 || gun === 6 || tatilMi) {
            // Hafta sonu veya resmi tatil: fiili saat * 0.5
            result.zam05 = Math.round(toplamSaat * 0.5 * 100) / 100;
            result.zam01 = 0;
        } else {
            // Hafta içi: fiili saat * 0.1
            result.zam01 = Math.round(toplamSaat * 0.1 * 100) / 100;
            result.zam05 = 0;
        }
        result.toplam = result.fiili + result.zam01 + result.zam05;
        return result;
    }

    function getGunAdi(tarihStr) {
        return gunAdlari[new Date(tarihStr).getDay()];
    }

    function escapeHtml(t) {
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(t || ''));
        return d.innerHTML;
    }

    function showToast(msg, type) {
        var bg = 'bg-success';
        if (type === 'error') bg = 'bg-danger';
        else if (type === 'warning') bg = 'bg-warning text-dark';
        
        var toastHtml = '<div class="toast ' + bg + ' text-white" role="alert">' +
            '<div class="toast-body">' + escapeHtml(msg) + '</div></div>';
        var toastDiv = document.createElement('div');
        toastDiv.innerHTML = toastHtml;
        document.body.appendChild(toastDiv);
        
        var toastEl = toastDiv.querySelector('.toast');
        var bsToast = new bootstrap.Toast(toastEl, { delay: 2500 });
        bsToast.show();
        
        toastEl.addEventListener('hidden.bs.toast', function() {
            toastDiv.remove();
        });
    }

    function showKilitPopup(msg) {
        document.getElementById('kilitPopupMesaj').textContent = msg;
        var modal = new bootstrap.Modal(document.getElementById('kilitPopupOverlay'));
        modal.show();
    }
    
    var kilitModal = new bootstrap.Modal(document.getElementById('kilitPopupOverlay'), { backdrop: 'static', keyboard: false });
    document.getElementById('kilitPopupBtn2').addEventListener('click', function() {
        kilitModal.hide();
    });

    // Personelleri yükle
    function loadPersoneller(birim, yuklemeNo, cb) {
        fetch('/Mesai/GetPersoneller?birim=' + encodeURIComponent(birim))
            .then(function(r) {
                if (!r.ok) throw new Error('Personeller yüklenemedi (' + r.status + ')');
                return r.json();
            })
            .then(function(data) {
                if (yuklemeNo !== mesaiYuklemeNo) return;
                if (data.hata) { showToast('Hata: ' + data.hata, 'error'); return; }
                if (!Array.isArray(data)) throw new Error('Personel listesi geçersiz biçimde döndü');
                personelListesi = data;
                fillPersonelRaporSecenegi(data);
                if (cb) cb();
            })
            .catch(function(error) { showToast(error.message || 'Personel yüklenemedi', 'error'); });
    }

    // Rapor kişisi seçici: birim değişince liste yenilenir, seçim sıfırlanır
    function fillPersonelRaporSecenegi(liste) {
        var sel = document.getElementById('personelRaporSelect');
        if (!sel) return;
        var onceki = sel.value;
        sel.innerHTML = '';
        var tumu = document.createElement('option');
        tumu.value = '';
        tumu.textContent = 'Rapor: Tüm Personeller';
        sel.appendChild(tumu);
        for (var i = 0; i < liste.length; i++) {
            var p = liste[i];
            var o = document.createElement('option');
            o.value = p.perNo || '';
            o.textContent = p.ad + ' ' + p.soyad;
            sel.appendChild(o);
        }
        // Aynı personel yeni listede varsa seçimi koru
        if (onceki && sel.querySelector('option[value="' + onceki + '"]')) sel.value = onceki;
        else sel.value = '';
    }

    // Mesai kayıtlarını yükle
    function loadMesai() {
        var birim = document.getElementById('birimSelect').value;
        var yil = parseInt(document.getElementById('yearSelect').value);
        var ay = parseInt(document.getElementById('monthSelect').value);
        if (!birim) { showToast('Birim seçin', 'warning'); return; }
        var yuklemeNo = ++mesaiYuklemeNo;
        currentBirim = birim;
        mesaiKayitlari = [];
        ayKilitKontrolHazir = false;
        ayKilitDurumunuGoster(true, 'Seçili ayın kilit durumu kontrol ediliyor...');
        renderTable();
        document.getElementById('btnSatirEkle').disabled = true;
        document.getElementById('btnSatirEkleBirim').disabled = true;
        document.getElementById('btnOnizlemeYatay').disabled = true;
        document.getElementById('btnExcelYatay').disabled = true;
        document.getElementById('btnHtmlYatay').disabled = true;
        document.getElementById('btnPdfYatay').disabled = true;

        fetch('/Mesai/AyKilitliMi?yil=' + yil + '&ay=' + ay)
            .then(function(r) {
                if (!r.ok) throw new Error('Ay kilit durumu kontrol edilemedi.');
                return r.json();
            })
            .then(function(durum) {
                if (yuklemeNo !== mesaiYuklemeNo) return;
                ayKilitKontrolHazir = true;
                ayKilitDurumunuGoster(!!durum.kilitli);
                if (durum.kilitli) showKilitPopup(ayAdlari[ay] + ' ' + yil + ' kilitli. Mesai kayıtları eklenemez, değiştirilemez veya silinemez.');

                fetch('/Mesai/GetSaatlikBrut')
                    .then(function(r) { return r.json(); })
                    .then(function(d) { saatlikBrut = parseFloat(d.saatlikBrut) || 0; })
                    .catch(function() { saatlikBrut = 0; });

                loadPersoneller(birim, yuklemeNo, function() {
                    if (yuklemeNo !== mesaiYuklemeNo) return;
            // Önce resmi tatilleri çek
            fetch('/Puantaj/GetResmiTatiller?yil=' + yil + '&ay=' + ay)
                .then(function(r) { return r.json(); })
                .then(function(tatilData) {
                    resmiTatiller = {};
                    if (Array.isArray(tatilData)) {
                        for (var i = 0; i < tatilData.length; i++) {
                            var g = tatilData[i].gun;
                            var tarihStr = yil + '-' + String(ay).padStart(2,'0') + '-' + String(g).padStart(2,'0');
                            resmiTatiller[tarihStr] = tatilData[i].tatilAdi;
                        }
                    }
                    return fetch('/Mesai/GetMesaiKayitlari?yil=' + yil + '&ay=' + ay + '&birim=' + encodeURIComponent(birim));
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.hata) { showToast('Hata: ' + data.hata, 'error'); return; }
                    mesaiKayitlari = data;
                    // Mevcut kayıtların zamlarını resmi tatillere göre yeniden hesapla
                    for (var i = 0; i < mesaiKayitlari.length; i++) {
                        var k = mesaiKayitlari[i];
                        var z = hesaplaZamlar(k.tarih, k.baslangic, k.bitis);
                        k.fiiliSaat = z.fiili;
                        k.zam01Saat = z.zam01;
                        k.zam05Saat = z.zam05;
                        k.toplamSaat = z.toplam;
                    }
                    renderTable();
                    document.getElementById('btnSatirEkle').disabled = ayKilitli;
                    document.getElementById('btnSatirEkleBirim').disabled = ayKilitli;
                    document.getElementById('btnOnizlemeYatay').disabled = false;
                    document.getElementById('btnExcelYatay').disabled = false;
                    document.getElementById('btnHtmlYatay').disabled = false;
                    document.getElementById('btnPdfYatay').disabled = false;
                    var tatilSayisi = Object.keys(resmiTatiller).length;
                    var msg = ayAdlari[ay] + ' ' + yil + ' yüklendi';
                    if (tatilSayisi > 0) msg += ' (' + tatilSayisi + ' resmi tatil)';
                    showToast(msg);
                })
                .catch(function() { showToast('Veri yüklenemedi', 'error'); });
                });
            })
            .catch(function() {
                if (yuklemeNo !== mesaiYuklemeNo) return;
                ayKilitKontrolHazir = false;
                ayKilitDurumunuGoster(true, 'Ay kilit durumu doğrulanamadı. Güvenlik için bu ayda mesai işlemleri devre dışı bırakıldı.');
                showToast('Ay kilit durumu kontrol edilemedi', 'error');
            });
    }

    // Tabloyu oluştur - THEAD: 11 sütun (Adı Soyadı|Tarih|Gün|Başlangıç|Bitiş|Fiili|Zam0.1|Zam0.5|TOPLAM|Açıklama|İşlem)
    function renderTable() {
        var tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';
        var tfFiili = 0, tfZam01 = 0, tfZam05 = 0, tfToplam = 0;

        for (var i = 0; i < mesaiKayitlari.length; i++) {
            var k = mesaiKayitlari[i];
            var tr = document.createElement('tr');
            tr.setAttribute('data-idx', i);

            tr.innerHTML =
                '<td class="text-start" style="width:140px">' + escapeHtml(k.adSoyad) + '</td>' +
                '<td style="width:160px"><input type="date" class="inp-tarih" value="' + k.tarih + '" data-idx="' + i + '"' + (ayKilitli ? ' disabled' : '') + '></td>' +
                '<td style="width:80px">' + getGunAdi(k.tarih) + '</td>' +
                '<td style="width:140px"><input type="time" class="inp-bas" value="' + k.baslangic + '" data-idx="' + i + '"' + (ayKilitli ? ' disabled' : '') + '></td>' +
                '<td style="width:140px"><input type="time" class="inp-bit" value="' + k.bitis + '" data-idx="' + i + '"' + (ayKilitli ? ' disabled' : '') + '></td>' +
                '<td style="width:80px" class="readonly-cell fiili-cell">' + parseFloat(k.fiiliSaat).toFixed(2) + '</td>' +
                '<td style="width:75px" class="readonly-cell">' + parseFloat(k.zam01Saat).toFixed(2) + '</td>' +
                '<td style="width:75px" class="readonly-cell">' + parseFloat(k.zam05Saat).toFixed(2) + '</td>' +
                '<td style="width:85px" class="readonly-cell toplam-cell">' + parseFloat(k.toplamSaat).toFixed(2) + '</td>' +
                '<td style="width:150px"><input type="text" class="inp-aciklama" value="' + escapeHtml(k.aciklama || '') + '" data-idx="' + i + '" style="width:110px"' + (ayKilitli ? ' disabled' : '') + '></td>' +
                '<td style="width:40px" class="no-print"><button class="btn btn-sm btn-danger btn-mesai-sil" data-idx="' + i + '"' + (ayKilitli ? ' disabled' : '') + '>X</button></td>';

            tbody.appendChild(tr);
            tfFiili += parseFloat(k.fiiliSaat);
            tfZam01 += parseFloat(k.zam01Saat);
            tfZam05 += parseFloat(k.zam05Saat);
            tfToplam += parseFloat(k.toplamSaat);
        }

        document.getElementById('tfFiili').textContent = tfFiili.toFixed(2);
        document.getElementById('tfZam01').textContent = tfZam01.toFixed(2);
        document.getElementById('tfZam05').textContent = tfZam05.toFixed(2);
        document.getElementById('tfToplam').textContent = tfToplam.toFixed(2);
        document.getElementById('footerToplam').textContent = tfToplam.toFixed(2);

        // Input olayları
        tbody.querySelectorAll('.inp-bas, .inp-bit').forEach(function(el) {
            el.addEventListener('change', function() {
                var idx = parseInt(this.dataset.idx);
                var row = this.closest('tr');
                var bas = row.querySelector('.inp-bas').value;
                var bit = row.querySelector('.inp-bit').value;
                var tarih = mesaiKayitlari[idx].tarih;
                mesaiKayitlari[idx].baslangic = bas;
                mesaiKayitlari[idx].bitis = bit;
                var z = hesaplaZamlar(tarih, bas, bit);
                mesaiKayitlari[idx].fiiliSaat = z.fiili;
                mesaiKayitlari[idx].zam01Saat = z.zam01;
                mesaiKayitlari[idx].zam05Saat = z.zam05;
                mesaiKayitlari[idx].toplamSaat = z.toplam;
                renderTable();
            });
        });

        tbody.querySelectorAll('.inp-tarih').forEach(function(el) {
            el.addEventListener('change', function() {
                var idx = parseInt(this.dataset.idx);
                mesaiKayitlari[idx].tarih = this.value;
                var bas = mesaiKayitlari[idx].baslangic;
                var bit = mesaiKayitlari[idx].bitis;
                var z = hesaplaZamlar(this.value, bas, bit);
                mesaiKayitlari[idx].fiiliSaat = z.fiili;
                mesaiKayitlari[idx].zam01Saat = z.zam01;
                mesaiKayitlari[idx].zam05Saat = z.zam05;
                mesaiKayitlari[idx].toplamSaat = z.toplam;
                renderTable();
            });
        });

        tbody.querySelectorAll('.inp-aciklama').forEach(function(el) {
            el.addEventListener('change', function() {
                var idx = parseInt(this.dataset.idx);
                mesaiKayitlari[idx].aciklama = this.value;
            });
        });

        tbody.querySelectorAll('.btn-mesai-sil').forEach(function(el) {
            el.addEventListener('click', function() {
                var idx = parseInt(this.dataset.idx);
                if (!confirm('Bu satırı silmek istediğinize emin misiniz?')) return;
                var kayit = mesaiKayitlari[idx];
                if (kayit.id && kayit.id > 0) {
                    fetch('/Mesai/SilMesai', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: kayit.id })
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(d) {
                        if (d.basarili) {
                            mesaiKayitlari.splice(idx, 1);
                            renderTable();
                            showToast('Silindi');
                        } else if (d.mesaj && d.mesaj.indexOf('kilitlenmiş') > -1) {
                            showKilitPopup(d.mesaj);
                        } else { showToast(d.mesaj, 'error'); }
                    });
                } else {
                    mesaiKayitlari.splice(idx, 1);
                    renderTable();
                }
            });
        });
    }

    // Satır ekle modal aç - fetch personeller
    function acPersonelModal(birim, showBirimAdi) {
        if (!ayKilitKontrolHazir || ayKilitli) {
            showKilitPopup('Seçili ay kilitli veya kilit durumu doğrulanamadı. Mesai kaydı eklenemez.');
            return;
        }

        fetch('/Mesai/GetPersoneller?birim=' + encodeURIComponent(birim))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.hata) { showToast('Hata: ' + data.hata, 'error'); return; }
                var sel = document.getElementById('modalPersonel');
                sel.innerHTML = '';
                for (var i = 0; i < data.length; i++) {
                    var p = data[i];
                    var o = document.createElement('option');
                    o.value = p.perNo || '';
                    o.dataset.personelId = p.perNo || '';
                    var birimText = showBirimAdi ? ' (' + (p.birimAdi || p.birim || '') + ')' : '';
                    o.textContent = p.ad + ' ' + p.soyad + birimText;
                    o.dataset.gorev = p.gorev || '';
                    sel.appendChild(o);
                }
                var yil = document.getElementById('yearSelect').value;
                var ay = document.getElementById('monthSelect').value;
                document.getElementById('modalTarih').value = yil + '-' + String(ay).padStart(2,'0') + '-01';
                var m = new bootstrap.Modal(document.getElementById('satirEkleModal'));
                m.show();
            })
            .catch(function() { showToast('Personel yüklenemedi', 'error'); });
    }

    // Yükle butonu
    var yukleBtn = document.getElementById('btnYukle');
    if (yukleBtn) {
        yukleBtn.addEventListener('click', loadMesai);
    }

    var birimSelect = document.getElementById('birimSelect');
    if (birimSelect) {
        birimSelect.addEventListener('change', function() {
            if (birimSelect.value) {
                fillPersonelRaporSecenegi([]);
                loadMesai();
            } else {
                personelListesi = [];
                mesaiKayitlari = [];
                fillPersonelRaporSecenegi([]);
                renderTable();
                document.getElementById('btnOnizlemeYatay').disabled = true;
                document.getElementById('btnExcelYatay').disabled = true;
                document.getElementById('btnHtmlYatay').disabled = true;
                document.getElementById('btnPdfYatay').disabled = true;
            }
        });
    }

    // Satır ekle (Tüm Personeller)
    document.getElementById('btnSatirEkle').addEventListener('click', function() {
        acPersonelModal('all', true);
    });

    // Satır ekle (Seçili Birim)
    document.getElementById('btnSatirEkleBirim').addEventListener('click', function() {
        var birim = document.getElementById('birimSelect').value;
        if (!birim || birim === 'all') { showToast('Bir birim seçin', 'warning'); return; }
        acPersonelModal(birim, false);
    });

    document.getElementById('btnModalEkle').addEventListener('click', function() {
        var sel = document.getElementById('modalPersonel');
        var perNo = sel.value;
        var pid = sel.options[sel.selectedIndex].dataset.personelId;
        var adSoyad = sel.options[sel.selectedIndex].textContent;
        var gorev = sel.options[sel.selectedIndex].dataset.gorev;
        var tarih = document.getElementById('modalTarih').value;
        var bas = document.getElementById('modalBaslangic').value;
        var bit = document.getElementById('modalBitis').value;
        var aciklama = document.getElementById('modalAciklama').value;
        if (!perNo || !pid || !tarih || !bas || !bit) { showToast('Personel per_no ve tüm alanları doldurun', 'warning'); return; }

        var fiili = saatFarki(bas, bit);
        var z = hesaplaZamlar(tarih, bas, bit);
        mesaiKayitlari.push({
            id: 0,
            personelId: pid,
            perNo: perNo,
            adSoyad: adSoyad,
            tarih: tarih,
            gorev: gorev,
            baslangic: bas,
            bitis: bit,
            fiiliSaat: z.fiili,
            zam01Saat: z.zam01,
            zam05Saat: z.zam05,
            toplamSaat: z.toplam,
            aciklama: aciklama
        });
        renderTable();
        document.getElementById('modalAciklama').value = '';
        bootstrap.Modal.getInstance(document.getElementById('satirEkleModal')).hide();
        showToast(adSoyad + ' eklendi');
    });

    // FastReport A4 Rapor Standardı (v3): Önizleme ve PDF aynı .frx şablonundan üretilir.
    // Kaydet ve Excel çıktısı kaldırıldı; çıktılar yalnızca sunucu tarafındaki şablon üzerinden alınır.
    function openReportUrl(action, indir) {
        var birim = document.getElementById('birimSelect').value;
        var yil = document.getElementById('yearSelect').value;
        var ay = document.getElementById('monthSelect').value;
        var personel = document.getElementById('personelRaporSelect') ? document.getElementById('personelRaporSelect').value : '';
        var url = '/Mesai/' + action + '?yil=' + encodeURIComponent(yil)
            + '&ay=' + encodeURIComponent(ay)
            + '&birim=' + encodeURIComponent(birim)
            + (personel ? '&personel=' + encodeURIComponent(personel) : '')
            + '&yon=yatay'
            + (indir ? '&indir=true' : '');
        window.open(url, '_blank', 'noopener');
    }

    document.getElementById('btnOnizlemeYatay').addEventListener('click', function(e) {
        e.preventDefault();
        if (mesaiKayitlari.length === 0) {
            showToast('Önizlenecek veri yok', 'warning');
            return;
        }
        openReportUrl('Rapor', false);
    });

    document.getElementById('btnPdfYatay').addEventListener('click', function(e) {
        e.preventDefault();
        if (mesaiKayitlari.length === 0) {
            showToast('Yazdırılacak veri yok', 'warning');
            return;
        }
        openReportUrl('RaporPdf', true);
    });

    document.getElementById('btnExcelYatay').addEventListener('click', function(e) {
        e.preventDefault();
        if (mesaiKayitlari.length === 0) {
            showToast('Dışa aktarılacak veri yok', 'warning');
            return;
        }
        var birim = document.getElementById('birimSelect').value;
        var yil = document.getElementById('yearSelect').value;
        var ay = document.getElementById('monthSelect').value;
        var raporPersonel = document.getElementById('personelRaporSelect') ? document.getElementById('personelRaporSelect').value : '';
        var url = '/Mesai/RaporExcel?yil=' + encodeURIComponent(yil)
            + '&ay=' + encodeURIComponent(ay)
            + '&birim=' + encodeURIComponent(birim)
            + (raporPersonel ? '&personel=' + encodeURIComponent(raporPersonel) : '');
        window.open(url, '_blank', 'noopener');
    });

    // HTML çıktısı .frx şablonundan üretilir (Excel'den farklı olarak tasarım şablondan gelir).
    document.getElementById('btnHtmlYatay').addEventListener('click', function(e) {
        e.preventDefault();
        if (mesaiKayitlari.length === 0) {
            showToast('Dışa aktarılacak veri yok', 'warning');
            return;
        }
        openReportUrl('RaporHtml', true);
    });



    function initPage() {
        initDateSelects();
        var sel = document.getElementById('birimSelect');
        if (sel && sel.value && sel.disabled) {
            loadMesai();
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage);
    } else {
        initPage();
    }
})();
</script>
}
