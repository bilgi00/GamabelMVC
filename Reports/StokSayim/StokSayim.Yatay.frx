<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" DoublePass="true"
        ReportInfo.Created="11/19/2026 00:00:00" ReportInfo.Modified="11/19/2026 00:00:00"
        ReportInfo.CreatorVersion="2026.2.3" ReportInfo.Version="1.0.0" ReportInfo.Description="A4 yatay stok sayım ve fark raporu">
  <Dictionary>
    <TableDataSource Name="Satirlar" ReferenceName="Data.Satirlar" DataType="System.Int32" Enabled="true">
      <Column Name="SiraNo" DataType="System.Int32"/>
      <Column Name="StokKodu" DataType="System.String"/>
      <Column Name="Barkod" DataType="System.String"/>
      <Column Name="UrunAdi" DataType="System.String"/>
      <Column Name="GirenMiktar" DataType="System.Decimal"/>
      <Column Name="CikanMiktar" DataType="System.Decimal"/>
      <Column Name="KalanMiktar" DataType="System.Decimal"/>
      <Column Name="SayimMiktari" DataType="System.Decimal"/>
      <Column Name="Fark" DataType="System.Decimal"/>
      <Column Name="Birim" DataType="System.String"/>
    </TableDataSource>
    <Parameter Name="BaslikAdi" DataType="System.String"/>
    <Parameter Name="SayimAdi" DataType="System.String"/>
    <Parameter Name="SayimDurumu" DataType="System.String"/>
    <Parameter Name="SayimNo" DataType="System.String"/>
    <Parameter Name="Tarih" DataType="System.String"/>
    <Parameter Name="OlusturanAd" DataType="System.String"/>
    <Parameter Name="UrunSayisi" DataType="System.Int32"/>
    <Parameter Name="SayilanUrunSayisi" DataType="System.Int32"/>
    <Parameter Name="SablonSurum" DataType="System.String"/>
    <Total Name="ToplamKalan" Expression="[Satirlar.KalanMiktar]" Evaluator="Data1" PrintOn="ReportSummary1"/>
    <Total Name="ToplamSayim" Expression="[Satirlar.SayimMiktari]" Evaluator="Data1" PrintOn="ReportSummary1"/>
    <Total Name="ToplamFark" Expression="[Satirlar.Fark]" Evaluator="Data1" PrintOn="ReportSummary1"/>
  </Dictionary>

  <ReportPage Name="Page1" Landscape="true" PaperWidth="297" PaperHeight="210"
